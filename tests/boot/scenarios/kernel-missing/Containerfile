# Boot-health scenario image "kernel-missing" (F6 of the design's test plan).
# The kernel image is empty, so GRUB cannot load it and must turn to the
# second loader entry in the same boot.
#
# Built FROM the boot-test image, so every other layer is identical and only
# this change is under test. Never part of TUR.

ARG BASE=localhost/tur-boot-test:ci
FROM ${BASE}

RUN set -eu; \
    kernel="$(ls -1 /usr/lib/modules | head -n1)"; \
    test -s "/usr/lib/modules/${kernel}/vmlinuz"; \
    : > "/usr/lib/modules/${kernel}/vmlinuz"; \
    mkdir -p /usr/lib/tur-boot-test; \
    echo kernel-missing > /usr/lib/tur-boot-test/scenario

LABEL org.tur.test-image="boot-health-scenario" org.tur.test-scenario="kernel-missing"
