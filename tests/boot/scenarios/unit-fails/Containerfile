# Boot-health scenario image "unit-fails" (F2 of the design's test plan).
# A unit that runs `false`, listed in required-units.d.
#
# Built FROM the boot-test image, so every other layer is identical and only
# this change is under test. Never part of TUR.

ARG BASE=localhost/tur-boot-test:ci
FROM ${BASE}

RUN set -eu; \
    printf '%s\n' '[Unit]' 'Description=A required unit that fails (boot-health test)' \
        '[Service]' 'Type=oneshot' 'RemainAfterExit=yes' 'ExecStart=/usr/bin/false' \
        > /usr/lib/systemd/system/tur-test-required.service; \
    ln -s ../tur-test-required.service \
        /usr/lib/systemd/system/multi-user.target.wants/tur-test-required.service; \
    echo tur-test-required.service > /usr/lib/tur/boot-health/required-units.d/tur-test-required.conf; \
    mkdir -p /usr/lib/tur-boot-test; \
    echo unit-fails > /usr/lib/tur-boot-test/scenario

LABEL org.tur.test-image="boot-health-scenario" org.tur.test-scenario="unit-fails"
