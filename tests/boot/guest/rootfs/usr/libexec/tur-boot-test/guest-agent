    cap session-processes.txt ps -U "${session_uid}" -o pid,ppid,etimes,rss,comm,args
    cap session-journal.txt journalctl -b --no-pager -o short-monotonic "_UID=${session_uid}"
    # What the compositor itself says it renders with. Asked on the session's
    # own bus, as the session's user.
    bus="unix:path=/run/user/${session_uid}/bus"
    runuser -u "$(id -nu "${session_uid}")" -- env "DBUS_SESSION_BUS_ADDRESS=${bus}" \
        timeout 30 busctl --address="${bus}" --json=short \
        call org.kde.KWin /KWin org.kde.KWin supportInformation \
        > "${out}/kwin-support.json" 2> "${out}/kwin-support.err"
    if [ ! -s "${out}/kwin-support.json" ]; then
        timeout 30 busctl --address="${bus}" --json=short \
            call org.kde.KWin /KWin org.kde.KWin supportInformation \
            > "${out}/kwin-support.json" 2>> "${out}/kwin-support.err"
    fi
    jq -r '.data[0]' "${out}/kwin-support.json" > "${out}/kwin-support-information.txt" 2>> "${out}/kwin-support.err"
fi
