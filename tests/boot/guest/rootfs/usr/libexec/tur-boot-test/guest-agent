# --- what the boot-health design assumes ---------------------------------------
measure
health_facts
if [ "${phase}" = third-boot ]; then
    canary
    # The arming unit acts when it is stopped, at shutdown. It must still be
    # there after the automount behind /boot has expired.
    put arm_unit_after_idle "$(systemctl show -p ActiveState --value tur-boot-arm.service 2> /dev/null)"
    put state_unit_after_idle "$(systemctl show -p ActiveState --value tur-boot-state.service 2> /dev/null)"
    cap grubenv-late.txt grub2-editenv "${grubenv}" list
    # Without tur-boot-health nothing removes the counter. Leave the disk as an
    # ordinary one: the scenarios start from it.
    if [ ! -x /usr/libexec/tur/tur-boot-health ] && grep -q '^boot_counter=' "${out}/grubenv-late.txt"; then
        editenv unset boot_counter > "${out}/grubenv-cleanup.txt" 2>&1
        put counter_removed_by agent
    fi
    cap grubenv-final.txt grub2-editenv "${grubenv}" list
fi

# --- TUR's own programs, on the installed system (second boot of the boot test) ----
# After everything above, so that what the boot itself is judged by was
# recorded before these ran; before the journal is kept, so that it holds them.
if [ "${phase}" = second-boot ] && [ "${prepare_only}" = no ]; then
    say "COMPONENTS-START running TUR's programs as ${test_user} uptime=$(uptime_s)"
    components
    say "COMPONENTS-DONE run_as=$(sed -n 's/^components_run_as=//p' "${status}") finished=$(sed -n 's/^components_finished=//p' "${status}") pax_e2e=$(sed -n 's/^pax_e2e_exit_status=//p' "${out}/components/status" 2> /dev/null) uptime=$(uptime_s)"
fi

# --- journal ------------------------------------------------------------------
journalctl -b --no-pager -o short-monotonic > "${out}/journal.txt" 2>&1
journalctl -b --no-pager -p warning -o short-monotonic > "${out}/journal-warnings.txt" 2>&1
journalctl -b --no-pager -o export 2> /dev/null | gzip -c > "${out}/journal.export.gz"

# --- first boot only: stand in for a person completing first-run setup -----------
if [ "${phase}" = first-boot ]; then
    {
        useradd --create-home --comment "TUR boot test" "${test_user}" && echo "created user ${test_user}"
        touch "${setup_done_flag}" && echo "created ${setup_done_flag}"
        getent passwd "${test_user}"
        ls -la "${setup_done_flag}"
    } > "${out}/prepare-second-boot.txt" 2>&1
    if getent passwd "${test_user}" > /dev/null && [ -e "${setup_done_flag}" ]; then
        put second_boot_prepared yes
    else
        put second_boot_prepared no
    fi
fi

# --- second boot only: set GRUB's boot counter by hand, as a trial would ---------
# Step 2 of the design's brief. The next boot must be counted by GRUB and the
# kernel must be told so. Done before the report is sent so that the report
# carries what was written.
if [ "${phase}" = second-boot ] && [ "${prepare_only}" = no ]; then
    {
        echo "--- before"
        grub2-editenv "${grubenv}" list
        filefrag -v "${grubenv}"
        echo "--- set boot_counter=2"
        editenv set boot_counter=2
        echo "exit status: $?"
        echo "--- after"
        grub2-editenv "${grubenv}" list
        filefrag -v "${grubenv}"
    } > "${out}/grubenv-armed.txt" 2>&1
    put armed_boot_counter "$(grub2-editenv "${grubenv}" list 2> /dev/null | sed -n 's/^boot_counter=//p')"
fi

put agent_finished_uptime "$(uptime_s)"

# --- send ---------------------------------------------------------------------
if wait_for 20 port; then
    if tar -C "${state}/report" -cf - "${phase}" > "${port}"; then
        say "report sent over ${port_name} phase=${phase}"
    else
        say "report NOT sent: writing to ${port} failed"
    fi
else
    say "report NOT sent: ${port} is missing"
fi
sync
finished="$(uptime_s)"

if [ "${phase}" = first-boot ]; then
    touch "${state}/first-boot-done"
    sync
    # Said three times: a kernel message can cut through a console line.
    for _ in 1 2 3; do
        sleep 1
        say "FIRST-BOOT-DONE uptime=${finished}"
    done
    # Time for the host to take its screenshot of this boot.
    sleep 20
    say "rebooting for the second boot"
    systemctl reboot
    exit 0
fi

if [ "${phase}" = second-boot ] && [ "${prepare_only}" = no ]; then
    touch "${state}/second-boot-done"
    sync
    for _ in 1 2 3; do
        sleep 1
        say "SECOND-BOOT-DONE uptime=${finished}"
    done
    # Time for the host to take its screenshots of this boot.
    sleep 45
    say "boot_counter set by hand to $(grub2-editenv "${grubenv}" list 2> /dev/null | sed -n 's/^boot_counter=//p'); rebooting for the third boot"
    systemctl reboot
    exit 0
fi

for _ in 1 2 3; do
    sleep 1
    say "COMPLETE uptime=${finished}"
done

# The host powers the guest off after its screenshot. If it does not, leave.
sleep 100
say "the host did not power the guest off; powering off"
systemctl poweroff
