# Boot-test image: the UOS image plus a test agent.
#
# The product image carries no test hooks. This layer adds one systemd unit and
# one script, and nothing else. The agent only runs in a virtual machine whose
# kernel command line contains uos.boot_test, which tests/boot/build-disk.sh
# sets at install time.

ARG BASE=localhost/uos:ci
FROM ${BASE}

COPY rootfs/ /

RUN set -eu; \
    chmod 0755 /usr/libexec/uos-boot-test/guest-agent; \
    mkdir -p /usr/lib/systemd/system/multi-user.target.wants; \
    ln -s ../uos-boot-test.service \
        /usr/lib/systemd/system/multi-user.target.wants/uos-boot-test.service; \
    bootc container lint

LABEL org.uos.test-image="boot"
