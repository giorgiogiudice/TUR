#
# Boot-test image: the TUR image plus a test agent.
#
# The product image carries no test hooks. This layer adds systemd units,
# the test's scripts and the fixtures of the P@x end-to-end test, and nothing
# else. The agent only runs in a virtual machine whose kernel command line
# contains tur.boot_test, which tests/boot/build-disk.sh sets at install time.
# guest-agent observes the boot test's three boots and, in the second, has
# component-checks run TUR's programs as an ordinary user; scenario-agent takes
# over in the boot-health scenarios (tests/boot/rollback.py), and
# signed-update-agent in the release workflow's test of signed updates
# (tests/boot/signed-update.py). A second unit, tur-desktop-check, runs only
# in the extra boot of tests/boot/splash.py (kernel argument
# tur.desktop_check) and records what a new account's desktop got (task D-04).
#
# The build context is the repository root, filtered by
# Containerfile.containerignore beside this file.

ARG BASE=localhost/tur:ci
FROM ${BASE}

COPY tests/boot/guest/rootfs/ /

# What tests/pax/e2e.py needs on the machine it runs on, where the pax
# workflow puts it on its Ubuntu runner (.github/workflows/pax.yml): the test
# itself with the files it reads from the repository, a fixture tree, the
# socket probe and the program behind the test service. The test is not
# changed for the guest; "repo" has the shape of the repository as far as the
# test looks at it. The same holds for P@x's session-service test and for
# P@x through local AI (tests/pax/service_e2e.py, tests/pax/local_model.py).
# /usr is read-only on the installed system, so these are part of the test
# image.
COPY tests/pax/ /usr/share/tur-pax-e2e/repo/tests/pax/
COPY services/tur-pax/tests/data/ /usr/share/tur-pax-e2e/repo/services/tur-pax/tests/data/
COPY services/tur-pax/data/ /usr/share/tur-pax-e2e/repo/services/tur-pax/data/
COPY services/tur-pax/interfaces/ /usr/share/tur-pax-e2e/repo/services/tur-pax/interfaces/
COPY services/tur-ai-local/agent-tools.json services/tur-ai-local/agent-tools.adapter.json \
     /usr/share/tur-pax-e2e/repo/services/tur-ai-local/
COPY services/tur-apps/agent-tools.json services/tur-apps/agent-tools.adapter.json \
     /usr/share/tur-pax-e2e/repo/services/tur-apps/
COPY services/tur-catalogue/agent-tools.json services/tur-catalogue/agent-tools.adapter.json \
     /usr/share/tur-pax-e2e/repo/services/tur-catalogue/
COPY services/tur-device-manager/agent-tools.json services/tur-device-manager/agent-tools.adapter.json \
     /usr/share/tur-pax-e2e/repo/services/tur-device-manager/
COPY services/tur-diagnostics/agent-tools.json services/tur-diagnostics/agent-tools.adapter.json \
     /usr/share/tur-pax-e2e/repo/services/tur-diagnostics/
COPY services/tur-runtime/agent-tools.json services/tur-runtime/agent-tools.adapter.json \
     /usr/share/tur-pax-e2e/repo/services/tur-runtime/
COPY services/tur-storage/agent-tools.json services/tur-storage/agent-tools.adapter.json \
     /usr/share/tur-pax-e2e/repo/services/tur-storage/
COPY services/tur-update/agent-tools.json services/tur-update/agent-tools.adapter.json \
     /usr/share/tur-pax-e2e/repo/services/tur-update/
COPY services/tur-device-manager/tests/fixtures/laptop/ /usr/share/tur-pax-e2e/laptop/

# What P@x's session-service test (tests/pax/service_e2e.py) starts besides
# the service: a private bus (dbus-daemon; the image's own session bus is
# dbus-broker) and a password store that speaks the Secret Service
# interface (gnome-keyring; the desktop's own is KWallet, which the test
# does not drive). Only in this test image, from the base's repositories,
# with the versions they hold on the day of the build; what came is listed.
RUN dnf -y --setopt=install_weak_deps=False install dbus-daemon gnome-keyring && \
    dnf clean all && \
    rpm -q --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n' dbus-daemon gnome-keyring \
        > /usr/share/tur-pax-e2e/added-packages.txt && \
    cat /usr/share/tur-pax-e2e/added-packages.txt

RUN set -eu; \
    chmod 0755 /usr/libexec/tur-boot-test/guest-agent /usr/libexec/tur-boot-test/scenario-agent \
        /usr/libexec/tur-boot-test/component-checks /usr/libexec/tur-boot-test/make-pe-fixture \
        /usr/libexec/tur-boot-test/signed-update-agent \
        /usr/libexec/tur-boot-test/heal-agent /usr/libexec/tur-boot-test/heal-pax \
        /usr/libexec/tur-boot-test/heal-receiver; \
    install -m 0644 /usr/share/tur-pax-e2e/repo/tests/pax/probe_sockets.py /usr/share/tur-pax-e2e/probe_sockets.py; \
    install -m 0755 /usr/share/tur-pax-e2e/repo/tests/pax/tur-pax-test-tool /usr/bin/tur-pax-test-tool; \
    find /usr/share/tur-pax-e2e -type d -exec chmod 0755 {} +; \
    find /usr/share/tur-pax-e2e -type f -exec chmod a+r {} +; \
    mkdir -p /usr/lib/systemd/system/multi-user.target.wants; \
    ln -s ../tur-boot-test.service \
        /usr/lib/systemd/system/multi-user.target.wants/tur-boot-test.service; \
    # The desktop check of the extra boot (tests/boot/splash.py; task D-04).
    chmod 0755 /usr/libexec/tur-boot-test/desktop-check; \
    ln -s ../tur-desktop-check.service \
        /usr/lib/systemd/system/multi-user.target.wants/tur-desktop-check.service; \
    bootc container lint

LABEL org.tur.test-image="boot"
