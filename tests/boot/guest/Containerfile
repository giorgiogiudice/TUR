# Boot-test image: the TUR image plus a test agent.
#
# The product image carries no test hooks. This layer adds one systemd unit and
# one script, and nothing else. The agent only runs in a virtual machine whose
# kernel command line contains tur.boot_test, which tests/boot/build-disk.sh
# sets at install time.

ARG BASE=localhost/tur:ci
FROM ${BASE}

COPY rootfs/ /

RUN set -eu; \
    chmod 0755 /usr/libexec/tur-boot-test/guest-agent; \
    mkdir -p /usr/lib/systemd/system/multi-user.target.wants; \
    ln -s ../tur-boot-test.service \
        /usr/lib/systemd/system/multi-user.target.wants/tur-boot-test.service; \
    bootc container lint

LABEL org.tur.test-image="boot"
