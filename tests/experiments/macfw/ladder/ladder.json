{
  "$comment": "SPDX-License-Identifier: LicenseRef-TUR-Noncommercial-1.0.0. The macfw ladder: Mac-only applications in order of expected difficulty for Darling, built from source on GitHub's macOS runner with Xcode's public toolchain (ci/oracle-macos.sh), never downloaded as binaries. Rungs 1, 2, 6 and 8 are TUR's own programs (ladder/own). Pins read on 2026-11-16 from the GitHub API. 'arch' is what the build produces; the candidate runs the x86_64 slice on x86-64 Linux and the arm64 slice on arm64 Linux. 'accept' is the rung's usable-window test (harness/ladder.py; report section 5.3).",
  "deployment_floor": "10.13",
  "rungs": [
    {
      "rung": 1,
      "name": "rung1-hello",
      "source": "own",
      "language": "Objective-C",
      "ui": "AppKit, code only",
      "surface": ["NSApplication", "NSApplicationDelegate", "NSMenu", "NSWindow", "NSStackView", "NSTextField", "NSButton"],
      "licence": "LicenseRef-TUR-Noncommercial-1.0.0",
      "build": {"kind": "own-objc", "file": "own/rung1-hello.m", "min_macos": "11.0"},
      "accept": {
        "ready": "^macfw-ready visible=1",
        "steps": [["type", "abc"], ["key", "Return"]],
        "expect": "^macfw-click 1 text=abc$"
      }
    },
    {
      "rung": 2,
      "name": "rung2-form",
      "source": "own",
      "language": "Objective-C",
      "ui": "AppKit, code only",
      "surface": ["NSSplitView", "NSTableView (cell-based, data source)", "NSScrollView", "NSTextView with undo", "NSPopUpButton", "NSSlider", "NSToolbar", "NSAlert sheet", "Auto Layout anchors"],
      "licence": "LicenseRef-TUR-Noncommercial-1.0.0",
      "build": {"kind": "own-objc", "file": "own/rung2-form.m", "min_macos": "11.0"},
      "accept": {
        "ready": "^macfw-ready visible=1 key=1 rows=8",
        "steps": [["click_rel", 0.12, 0.30], ["click_rel", 0.60, 0.60], ["type", "xyz"]],
        "expect_all": ["^macfw-select [0-9]+$", "^macfw-text 11$"]
      }
    },
    {
      "rung": 3,
      "name": "TableTool",
      "source": "https://github.com/jakob/TableTool",
      "commit": "066e66d8dab6e821dd7fb1dcbe1967b746693fe0",
      "licence": "MIT",
      "language": "Objective-C (12 .m)",
      "ui": "AppKit + 5 XIB",
      "surface": ["NSDocument (CSV)", "NSDocumentController", "nib loading", "NSTableView", "NSToolbar", "NSPopover"],
      "third_party": [],
      "build": {"kind": "xcodebuild", "project": "Table Tool.xcodeproj", "target": "Table Tool",
                "settings": {"MACOSX_DEPLOYMENT_TARGET": "10.13"}},
      "app": "Table Tool.app",
      "fixture": "gen:csv",
      "accept": {"open_fixture": true, "steps": [["key", "Down"], ["key", "Return"], ["type", "edited"], ["key", "Return"]],
                 "expect": "screen-change"}
    },
    {
      "rung": 4,
      "name": "Itsycal",
      "source": "https://github.com/sfsam/Itsycal",
      "commit": "95395138e25bb1624457aa2b96438328ec532d4a",
      "commit_note": "tag 0.15.15, the macOS 11 branch; HEAD needs macOS 27",
      "licence": "MIT",
      "language": "Objective-C (36 .m)",
      "ui": "AppKit, mostly code-built views + MainMenu.xib",
      "surface": ["NSStatusItem", "NSPopover / borderless panel", "custom NSView drawing (month grid)", "EventKit", "NSUserDefaults"],
      "third_party": ["MASShortcut.framework and Sparkle.framework, vendored binaries in the repository (not Apple)"],
      "build": {"kind": "xcodebuild", "project": "Itsycal.xcodeproj", "target": "Itsycal",
                "prepare": ["cp Local.xcconfig.example Local.xcconfig"]},
      "app": "Itsycal.app",
      "defaults": {"com.mowglii.ItsycalApp": {"SUEnableAutomaticChecks": false}},
      "accept": {"window_min": [150, 120], "steps": [["click_status_item"]], "expect": "screen-change",
                 "note": "a menu-bar app: its 'window' is the calendar shown when the status item is clicked"}
    },
    {
      "rung": 5,
      "name": "HexFiend",
      "source": "https://github.com/HexFiend/HexFiend",
      "commit": "32cb2ef78d2ff3bc6ecf326a6b19eeebb2945c13",
      "licence": "BSD-2-Clause",
      "language": "Objective-C (112 .m) and 6 Swift files",
      "ui": "AppKit + 18 XIB, own framework",
      "surface": ["NSDocument", "custom text and hex views", "NSScroller", "NSOutlineView (templates)", "NSTextView", "Tcl (templates)"],
      "third_party": ["Sparkle (SwiftPM, binary)", "swift-argument-parser (SwiftPM, source)"],
      "build": {"kind": "xcodebuild", "project": "app/HexFiend_2.xcodeproj", "scheme": "Release"},
      "app": "Hex Fiend.app",
      "fixture": "gen:bytes",
      "defaults": {"com.ridiculousfish.HexFiend": {"SUEnableAutomaticChecks": false}},
      "accept": {"open_fixture": true, "steps": [["key", "Page_Down"]], "expect": "screen-change"}
    },
    {
      "rung": 6,
      "name": "rung6-swift",
      "source": "own",
      "language": "Swift",
      "ui": "AppKit, code only",
      "surface": ["rung 1's surface, through AppKit's and Foundation's Swift API"],
      "licence": "LicenseRef-TUR-Noncommercial-1.0.0",
      "build": {"kind": "own-swift", "file": "own/rung6-swift.swift", "min_macos": "14.0"},
      "accept": {"ready": "^macfw-ready visible=1", "steps": [["type", "abc"], ["key", "Return"]],
                 "expect": "^macfw-click 1 text=abc$"}
    },
    {
      "rung": 7,
      "name": "HiddenBar",
      "source": "https://github.com/dwarvesf/hidden",
      "commit": "a5eab837dc88ab648f3477e0a53fe0325d9f7beb",
      "licence": "MIT",
      "language": "Swift (about 75 non-test files)",
      "ui": "AppKit + storyboard",
      "surface": ["NSStatusItem", "storyboard loading", "preferences window", "NSUserDefaults"],
      "third_party": ["HotKey (SwiftPM)", "Sparkle (SwiftPM, binary)"],
      "build": {"kind": "xcodebuild", "project": "Hidden Bar.xcodeproj", "scheme": "Hidden Bar"},
      "app": "Hidden Bar.app",
      "defaults": {"com.dwarvesv.minimalbar": {"SUEnableAutomaticChecks": false}},
      "accept": {"window_min": [300, 200], "note": "first launch opens the preferences window",
                 "steps": [["click_rel", 0.5, 0.5]], "expect": "window"}
    },
    {
      "rung": 8,
      "name": "rung8-swiftui",
      "source": "own",
      "language": "Swift",
      "ui": "SwiftUI App",
      "surface": ["App", "WindowGroup", "Text", "TextField", "Button", "List with selection", "@State"],
      "licence": "LicenseRef-TUR-Noncommercial-1.0.0",
      "build": {"kind": "own-swiftui", "file": "own/rung8-swiftui.swift", "min_macos": "14.0"},
      "accept": {"ready": "^macfw-ready visible=1", "steps": [["type", "abc"], ["key", "Return"]],
                 "expect": "^macfw-click 1 text=abc$"}
    },
    {
      "rung": 9,
      "name": "TomatoBar",
      "source": "https://github.com/ivoronin/TomatoBar",
      "commit": "90a77d664dfe33c016bf24f89b0c82e77f9aec84",
      "licence": "MIT",
      "language": "Swift (7 files)",
      "ui": "SwiftUI in an NSPopover",
      "surface": ["NSStatusItem", "NSPopover", "NSHostingController", "SwiftUI controls", "Timer"],
      "third_party": ["KeyboardShortcuts", "LaunchAtLogin", "SwiftState (SwiftPM, source)"],
      "build": {"kind": "xcodebuild", "project": "TomatoBar.xcodeproj", "scheme": "TomatoBar"},
      "app": "TomatoBar.app",
      "accept": {"window_min": [200, 150], "steps": [["click_status_item"]], "expect": "screen-change"}
    },
    {
      "rung": 10,
      "name": "SwiftUI-Kit",
      "source": "https://github.com/jordansinger/SwiftUI-Kit",
      "commit": "1211aa6b1aee07a3860e4f45d5cd5efcfec64509",
      "licence": "MIT",
      "language": "Swift (18 files)",
      "ui": "SwiftUI App",
      "surface": ["WindowGroup", "NavigationView sidebar", "List", "every standard control", "SF Symbols", "MapKit Map"],
      "third_party": [],
      "build": {"kind": "xcodebuild", "project": "SwiftUI Kit.xcodeproj", "target": "SwiftUI Kit Mac"},
      "app": "SwiftUI Kit.app",
      "accept": {"window_min": [500, 300], "steps": [["click_rel", 0.1, 0.3]], "expect": "screen-change"}
    }
  ],
  "rejected": [
    {"name": "TextEdit (darlinghq/darling-TextEdit)", "why": "Apple's own sample code: Apple source, which this experiment never copies or builds"},
    {"name": "CotEditor", "why": "645 Swift files and about 30 SwiftPM packages: a possible stretch rung, not a ladder step"},
    {"name": "Maccy", "why": "10 SwiftPM packages including swift-syntax macros, SwiftData: beyond rung 10 in difficulty"},
    {"name": "Latest (mangerlahn/Latest)", "why": "ships Apple-private framework headers"},
    {"name": "Vienna", "why": "private WebKit header, WebKit-heavy"},
    {"name": "KeyCastr", "why": "needs Input Monitoring permission to do anything"},
    {"name": "Rectangle, AltTab, Ice, Stats, MonitorControl, LuLu", "why": "accessibility, private API, hardware access or a system extension: not about AppKit"}
  ]
}
