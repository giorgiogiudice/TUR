<!-- The probe application of the Android experiment: one activity that
     exercises the integration points TUR's design depends on and logs what
     happened under the tag TURPROBE. Built in CI by build.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.tur.probe">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="TUR probe"
        android:hasCode="true"
        android:extractNativeLibs="true">
        <activity
            android:name=".ProbeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
