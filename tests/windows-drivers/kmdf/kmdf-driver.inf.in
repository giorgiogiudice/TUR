; SPDX-License-Identifier: LicenseRef-TUR-Noncommercial-1.0.0
;
; Template for the experiment's KMDF driver packages (build-fx2.sh fills in
; @NAME@, @HWID@, @DESC@): a function driver for one USB device, with the
; [*.Wdf] section a KMDF package carries. Unsigned; Wine only. Written for
; the experiment (the kmdf_fx2 sample's own .inx needs the WDK's stampinf).

[Version]
Signature   = "$WINDOWS NT$"
Class       = USBDevice
ClassGuid   = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider    = %Provider%
DriverVer   = 11/13/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %Disk%,,,

[SourceDisksFiles]
@NAME@.sys = 1

[Manufacturer]
%Provider% = Models,NTamd64

[Models.NTamd64]
%DeviceDesc% = Install, @HWID@

[Install]
CopyFiles = Files

[Files]
@NAME@.sys

[Install.Services]
AddService = @NAME@, 0x00000002, Service

[Service]
DisplayName   = %ServiceName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\@NAME@.sys

[Install.Wdf]
KmdfService = @NAME@, WdfSection

[WdfSection]
KmdfLibraryVersion = 1.33

[Strings]
Provider    = "TUR test"
Disk        = "TUR test driver disk"
DeviceDesc  = "@DESC@"
ServiceName = "@NAME@ (KMDF)"
