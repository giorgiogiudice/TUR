 /***********************************************************************
  *           PoRequestPowerIrp   (NTOSKRNL.EXE.@)
  */
+struct power_request
+{
+    DEVICE_OBJECT *device;
+    UCHAR minor;
+    POWER_STATE state;
+    PREQUEST_POWER_COMPLETE complete_cb;
+    void *ctx;
+};
+
+static NTSTATUS WINAPI power_request_complete( DEVICE_OBJECT *device, IRP *irp, void *context )
+{
+    struct power_request *request = context;
+
+    TRACE( "device %p, irp %p, status %#lx\n", request->device, irp, irp->IoStatus.Status );
+
+    if (request->complete_cb)
+        request->complete_cb( request->device, request->minor, request->state, request->ctx, &irp->IoStatus );
+    HeapFree( GetProcessHeap(), 0, request );
+    IoFreeIrp( irp );
+    return STATUS_MORE_PROCESSING_REQUIRED;
+}
+
 NTSTATUS WINAPI PoRequestPowerIrp( DEVICE_OBJECT *device, UCHAR minor,
-        POWER_STATE state, PREQUEST_POWER_COMPLETE complete_cb, void *ctx, IRP **irp )
+        POWER_STATE state, PREQUEST_POWER_COMPLETE complete_cb, void *ctx, IRP **irp_ret )
+{
+    struct power_request *request;
+    IO_STACK_LOCATION *stack;
+    DEVICE_OBJECT *top;
+    IRP *irp;
+
+    TRACE( "device %p, minor %#x, state %u, complete_cb %p, ctx %p, irp %p\n",
+           device, minor, state.DeviceState, complete_cb, ctx, irp_ret );
+
+    if (minor != IRP_MN_SET_POWER && minor != IRP_MN_QUERY_POWER)
+    {
+        FIXME( "minor %#x not supported\n", minor );
+        return STATUS_NOT_SUPPORTED;
+    }
+    if (!(request = HeapAlloc( GetProcessHeap(), 0, sizeof(*request) ))) return STATUS_INSUFFICIENT_RESOURCES;
+    top = IoGetAttachedDeviceReference( device );
+    if (!(irp = IoAllocateIrp( top->StackSize, FALSE )))
+    {
+        ObDereferenceObject( top );
+        HeapFree( GetProcessHeap(), 0, request );
+        return STATUS_INSUFFICIENT_RESOURCES;
+    }
+    request->device = device;
+    request->minor = minor;
+    request->state = state;
+    request->complete_cb = complete_cb;
+    request->ctx = ctx;
+
+    irp->IoStatus.Status = STATUS_NOT_SUPPORTED;
+    stack = IoGetNextIrpStackLocation( irp );
+    stack->MajorFunction = IRP_MJ_POWER;
+    stack->MinorFunction = minor;
+    stack->Parameters.Power.Type = DevicePowerState;
+    stack->Parameters.Power.State = state;
+    IoSetCompletionRoutine( irp, power_request_complete, request, TRUE, TRUE, TRUE );
+    if (irp_ret) *irp_ret = irp;
+    PoCallDriver( top, irp );
+    ObDereferenceObject( top );
+    return STATUS_PENDING;
+}
+
+/***********************************************************************
+ *           PoGetSystemWake   (NTOSKRNL.EXE.@)
+ */
+BOOLEAN WINAPI PoGetSystemWake( IRP *irp )
+{
+    FIXME( "irp %p: no system wake\n", irp );
+    return FALSE;
+}
+
+/***********************************************************************
+ *           PoSetSystemWake   (NTOSKRNL.EXE.@)
+ */
+void WINAPI PoSetSystemWake( IRP *irp )
 {
-    FIXME("device %p, minor %#x, state %u, complete_cb %p, ctx %p, irp %p, stub!\n",
-            device, minor, state.DeviceState, complete_cb, ctx, irp);
-    return STATUS_NOT_IMPLEMENTED;
+    FIXME( "irp %p: no system wake\n", irp );
 }
 
