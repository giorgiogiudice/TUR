From 9da55be68fd7867919f667b5e6490cd00d84edda Mon Sep 17 00:00:00 2001
From: TUR experiment <tur-experiment@users.noreply.github.com>
Date: Fri, 13 Nov 2026 10:50:50 +0300
Subject: [PATCH 10/11] ntoskrnl.exe: Add more functions the KMDF runtime
 imports.

Not exported before, so the Kernel-Mode Driver Framework's image did not
load: the high-resolution timer functions (ExAllocateTimer fails, so callers
use KeSetTimer timers), IoGetActivityIdIrp/IoSetActivityIdIrp (no event
tracing), IoGetInitiatorProcess, IoQueryFullDriverPath (the image's path
from its loader entry), and the Driver Verifier queries VfIsRuleClassEnabled
and VfCheckNxPoolType (no verifier).
---
 dlls/ntoskrnl.exe/ntoskrnl.c        | 96 +++++++++++++++++++++++++++++
 dlls/ntoskrnl.exe/ntoskrnl.exe.spec | 10 +++
 2 files changed, 106 insertions(+)

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index f83e4b7..dc45103 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -4175,6 +4175,102 @@ NTSTATUS WINAPI EtwActivityIdControl( ULONG code, GUID *guid )
     return STATUS_NOT_SUPPORTED;
 }
 
+/*****************************************************
+ *           ExAllocateTimer    (NTOSKRNL.EXE.@)
+ *
+ * High-resolution and no-wake timers (Windows 8.1) are not available:
+ * callers fall back to KeSetTimer timers.
+ */
+void * WINAPI ExAllocateTimer( void *callback, void *context, ULONG attributes )
+{
+    FIXME( "callback %p, context %p, attributes %#lx: not supported\n", callback, context, attributes );
+    return NULL;
+}
+
+/*****************************************************
+ *           ExSetTimer    (NTOSKRNL.EXE.@)
+ */
+BOOLEAN WINAPI ExSetTimer( void *timer, LONGLONG duetime, LONGLONG period, void *parameters )
+{
+    FIXME( "timer %p: not supported\n", timer );
+    return FALSE;
+}
+
+/*****************************************************
+ *           ExCancelTimer    (NTOSKRNL.EXE.@)
+ */
+BOOLEAN WINAPI ExCancelTimer( void *timer, void *parameters )
+{
+    FIXME( "timer %p: not supported\n", timer );
+    return FALSE;
+}
+
+/*****************************************************
+ *           ExDeleteTimer    (NTOSKRNL.EXE.@)
+ */
+BOOLEAN WINAPI ExDeleteTimer( void *timer, BOOLEAN cancel, BOOLEAN wait, void *parameters )
+{
+    FIXME( "timer %p: not supported\n", timer );
+    return FALSE;
+}
+
+/*****************************************************
+ *           IoGetActivityIdIrp    (NTOSKRNL.EXE.@)
+ */
+NTSTATUS WINAPI IoGetActivityIdIrp( IRP *irp, GUID *guid )
+{
+    TRACE( "%p, %p\n", irp, guid );
+    return STATUS_NOT_FOUND;
+}
+
+/*****************************************************
+ *           IoSetActivityIdIrp    (NTOSKRNL.EXE.@)
+ */
+NTSTATUS WINAPI IoSetActivityIdIrp( IRP *irp, const GUID *guid )
+{
+    TRACE( "%p, %p\n", irp, guid );
+    return STATUS_SUCCESS;
+}
+
+/*****************************************************
+ *           IoGetInitiatorProcess    (NTOSKRNL.EXE.@)
+ */
+PEPROCESS WINAPI IoGetInitiatorProcess( FILE_OBJECT *file )
+{
+    TRACE( "%p\n", file );
+    return NULL;
+}
+
+/*****************************************************
+ *           IoQueryFullDriverPath    (NTOSKRNL.EXE.@)
+ */
+NTSTATUS WINAPI IoQueryFullDriverPath( DRIVER_OBJECT *driver, UNICODE_STRING *path )
+{
+    LDR_DATA_TABLE_ENTRY *ldr = driver->DriverSection;
+
+    TRACE( "%p, %p\n", driver, path );
+
+    if (!ldr) return STATUS_UNSUCCESSFUL;
+    return RtlDuplicateUnicodeString( 1, &ldr->FullDllName, path );
+}
+
+/*****************************************************
+ *           VfIsRuleClassEnabled    (NTOSKRNL.EXE.@)
+ */
+BOOLEAN WINAPI VfIsRuleClassEnabled( ULONG rule_class )
+{
+    TRACE( "%lu\n", rule_class );
+    return FALSE;
+}
+
+/*****************************************************
+ *           VfCheckNxPoolType    (NTOSKRNL.EXE.@)
+ */
+void WINAPI VfCheckNxPoolType( POOL_TYPE type, void *caller, ULONG tag )
+{
+    TRACE( "%u, %p, %#lx\n", type, caller, tag );
+}
+
 /*****************************************************
  *           IoCsqInitialize  (NTOSKRNL.EXE.@)
  */
diff --git a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
index 8107df4..ea91b35 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
+++ b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
@@ -1744,3 +1744,13 @@
 
 @ cdecl wine_ntoskrnl_main_loop(long)
 @ cdecl wine_enumerate_root_devices(wstr)
+@ stdcall ExAllocateTimer(ptr ptr long)
+@ stdcall ExCancelTimer(ptr ptr)
+@ stdcall ExDeleteTimer(ptr long long ptr)
+@ stdcall ExSetTimer(ptr int64 int64 ptr)
+@ stdcall IoGetActivityIdIrp(ptr ptr)
+@ stdcall IoGetInitiatorProcess(ptr)
+@ stdcall IoQueryFullDriverPath(ptr ptr)
+@ stdcall IoSetActivityIdIrp(ptr ptr)
+@ stdcall VfCheckNxPoolType(long ptr long)
+@ stdcall VfIsRuleClassEnabled(long)
