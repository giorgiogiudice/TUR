Date: Fri, 13 Nov 2026 10:08:22 +0300
Subject: [PATCH 6/6] ntoskrnl.exe: Add IoOpenDriverRegistryKey.

Drivers built for Windows 10 2004 and later, the Kernel-Mode Driver
Framework among them, open their Parameters key with it; without it the
image does not load. Open or create Parameters (or State) under the
driver's service key.
---
 dlls/ntoskrnl.exe/ntoskrnl.c        | 37 +++++++++++++++++++++++++++++
 dlls/ntoskrnl.exe/ntoskrnl.exe.spec |  1 +
 include/ddk/wdm.h                   |  1 +
 3 files changed, 39 insertions(+)

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index 6faade5..a1611f6 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -1161,6 +1161,43 @@ PVOID WINAPI IoGetDriverObjectExtension( PDRIVER_OBJECT DriverObject,
 }
 
 
+/***********************************************************************
+ *           IoOpenDriverRegistryKey  (NTOSKRNL.EXE.@)
+ */
+NTSTATUS WINAPI IoOpenDriverRegistryKey( DRIVER_OBJECT *driver_object, DRIVER_REGKEY_TYPE type,
+                                         ACCESS_MASK access, ULONG flags, HANDLE *key )
+{
+    UNICODE_STRING name;
+    OBJECT_ATTRIBUTES attr;
+    HANDLE service;
+    NTSTATUS status;
+
+    TRACE( "%p, %u, %#lx, %#lx, %p\n", driver_object, type, access, flags, key );
+
+    if (flags) return STATUS_INVALID_PARAMETER;
+    switch (type)
+    {
+    case DriverRegKeyParameters:
+        RtlInitUnicodeString( &name, L"Parameters" );
+        break;
+    case DriverRegKeyPersistentState:
+        RtlInitUnicodeString( &name, L"State" );
+        break;
+    default:
+        FIXME( "key type %u not supported\n", type );
+        return STATUS_INVALID_PARAMETER;
+    }
+
+    InitializeObjectAttributes( &attr, &driver_object->DriverExtension->ServiceKeyName,
+                                OBJ_CASE_INSENSITIVE | OBJ_KERNEL_HANDLE, NULL, NULL );
+    if ((status = ZwOpenKey( &service, KEY_CREATE_SUB_KEY, &attr ))) return status;
+    InitializeObjectAttributes( &attr, &name, OBJ_CASE_INSENSITIVE | OBJ_KERNEL_HANDLE, service, NULL );
+    status = ZwCreateKey( key, access, &attr, 0, NULL, REG_OPTION_NON_VOLATILE, NULL );
+    ZwClose( service );
+    return status;
+}
+
+
 /***********************************************************************
  *           IoInitializeIrp  (NTOSKRNL.EXE.@)
  */
diff --git a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
index 13564ef..230df87 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
+++ b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
@@ -439,6 +439,7 @@
 @ stub IoMakeAssociatedIrp
 @ stub IoOpenDeviceInterfaceRegistryKey
 @ stdcall IoOpenDeviceRegistryKey(ptr long long ptr)
+@ stdcall IoOpenDriverRegistryKey(ptr long long long ptr)
 @ stub IoPageRead
 @ stub IoPnPDeliverServicePowerNotification
 @ stdcall IoQueryDeviceDescription(ptr ptr ptr ptr ptr ptr ptr ptr)
diff --git a/include/ddk/wdm.h b/include/ddk/wdm.h
index bef2cfa..ff2dcd0 100644
--- a/include/ddk/wdm.h
+++ b/include/ddk/wdm.h
@@ -1934,6 +1934,7 @@ void      WINAPI IoInvalidateDeviceRelations(PDEVICE_OBJECT,DEVICE_RELATION_TYPE
 BOOLEAN   WINAPI IoIs32bitProcess(IRP*);
 #endif
 NTSTATUS  WINAPI IoOpenDeviceRegistryKey(DEVICE_OBJECT*,ULONG,ACCESS_MASK,HANDLE*);
+NTSTATUS  WINAPI IoOpenDriverRegistryKey(DRIVER_OBJECT*,DRIVER_REGKEY_TYPE,ACCESS_MASK,ULONG,HANDLE*);
 void      WINAPI IoQueueWorkItem(PIO_WORKITEM,PIO_WORKITEM_ROUTINE,WORK_QUEUE_TYPE,void*);
 NTSTATUS  WINAPI IoRegisterDeviceInterface(PDEVICE_OBJECT,const GUID*,PUNICODE_STRING,PUNICODE_STRING);
 void      WINAPI IoReleaseCancelSpinLock(KIRQL);
