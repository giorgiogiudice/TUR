Date: Fri, 13 Nov 2026 10:08:22 +0300
Subject: [PATCH 4/6] ntoskrnl.exe: Add a WmiQueryTraceInformation that fails.

It was a stub, so calling it aborted the driver host. The Kernel-Mode Driver
Framework calls it while starting, to find the WDF performance-trace
callbacks, and falls back to its own table when the query fails. There is
no kernel event tracing in Wine: report STATUS_NOT_SUPPORTED.
---
 dlls/ntoskrnl.exe/ntoskrnl.c        | 12 ++++++++++++
 dlls/ntoskrnl.exe/ntoskrnl.exe.spec |  2 +-
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index 4455538..bfbc613 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -4846,6 +4846,18 @@ NTSTATUS WINAPI SeLocateProcessImageName(PEPROCESS process, UNICODE_STRING **ima
     return STATUS_SUCCESS;
 }
 
+/*********************************************************************
+ *           WmiQueryTraceInformation    (NTOSKRNL.@)
+ */
+NTSTATUS WINAPI WmiQueryTraceInformation( ULONG info_class, void *info, ULONG length, ULONG *required,
+                                          void *buffer )
+{
+    FIXME( "class %lu, info %p, length %lu, required %p, buffer %p: not supported\n",
+           info_class, info, length, required, buffer );
+    if (required) *required = 0;
+    return STATUS_NOT_SUPPORTED;
+}
+
 /*********************************************************************
  *           KeFlushQueuedDpcs    (NTOSKRNL.@)
  */
diff --git a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
index 90af2b6..913b504 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
+++ b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
@@ -1401,7 +1401,7 @@
 @ stub WRITE_REGISTER_USHORT
 @ stub WmiFlushTrace
 @ stub WmiQueryTrace
-@ stub WmiQueryTraceInformation
+@ stdcall WmiQueryTraceInformation(long ptr long ptr ptr)
 @ stub WmiStartTrace
 @ stub WmiStopTrace
 @ stub WmiTraceMessage
