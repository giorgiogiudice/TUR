<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  org.uos.Storage1: volume inventory, mount decisions and mount operations.

  Status: proposed, not frozen, and not implemented. No service exports this
  interface yet. The contract for every method (authorisation, return type,
  error names, timeout and cancellation) is in docs/architecture/storage.md.

  Bus: system bus. Well-known name: org.uos.Storage1. Object: /org/uos/Storage1.

  JSON results conform to schemas/storage-volume.schema.json. The service
  orchestrates UDisks2 and libblockdev; it does not replace them.

  There is deliberately no method for formatting, partitioning or encrypting
  a device.
-->
<node name="/org/uos/Storage1">
  <interface name="org.uos.Storage1">

    <!-- Version of the JSON documents returned by this interface. -->
    <property name="SchemaVersion" type="u" access="read"/>

    <!--
      ListVolumes: the inventory, with the decision a read/write request would
      get for each volume and the runtime views.
      options: reserved; pass an empty dictionary.
      inventory: JSON document of kind "inventory".
    -->
    <method name="ListVolumes">
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="inventory" type="s" direction="out"/>
    </method>

    <!--
      PreviewMount: the decision a Mount call would act on, without acting.
      volume_id: UOS volume identifier.
      access: "read-only" or "read-write".
      options: reserved; pass an empty dictionary.
      decision: JSON document of kind "decision".
    -->
    <method name="PreviewMount">
      <arg name="volume_id" type="s" direction="in"/>
      <arg name="access" type="s" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="decision" type="s" direction="out"/>
    </method>

    <!--
      Mount: mount a volume at its canonical path and create its runtime views.
      The service decides again at call time; a read/write request may result
      in a read-only mount, which the returned decision states.
      options: "operation-id" (s), chosen by the caller, to allow Cancel.
      result: JSON document of kind "decision" describing what was done.
    -->
    <method name="Mount">
      <arg name="volume_id" type="s" direction="in"/>
      <arg name="access" type="s" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="result" type="s" direction="out"/>
    </method>

    <!--
      Unmount: remove the runtime views and unmount the canonical mount.
      options: "operation-id" (s), chosen by the caller, to allow Cancel.
    -->
    <method name="Unmount">
      <arg name="volume_id" type="s" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
    </method>

    <!--
      Unlock: unlock an encrypted container. The passphrase is never an
      argument: the service asks for it through the system's authentication
      agent.
      options: "operation-id" (s), chosen by the caller, to allow Cancel.
      cleartext_volume_id: identifier of the volume inside the container.
    -->
    <method name="Unlock">
      <arg name="volume_id" type="s" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="cleartext_volume_id" type="s" direction="out"/>
    </method>

    <!--
      Cancel: cancel an operation started by the same caller.
      operation_id: the "operation-id" given to Mount, Unmount or Unlock.
    -->
    <method name="Cancel">
      <arg name="operation_id" type="s" direction="in"/>
    </method>

    <!-- A volume appeared in the inventory. -->
    <signal name="VolumeAdded">
      <arg name="volume_id" type="s"/>
    </signal>

    <!-- A volume left the inventory. -->
    <signal name="VolumeRemoved">
      <arg name="volume_id" type="s"/>
    </signal>

    <!-- A volume's facts, decision or mount state changed. -->
    <signal name="VolumeChanged">
      <arg name="volume_id" type="s"/>
    </signal>

  </interface>
</node>
