{
  "schema_version": 1,
  "service": "org.tur.Device1",
  "adapters": [
    {
      "tool": "device_get_inventory",
      "kind": "command",
      "program": "/usr/bin/tur-device",
      "arguments": [{ "literal": "inventory" }, { "literal": "--json" }, { "literal": "--redact" }],
      "timeout_seconds": 30,
      "max_output_bytes": 262144
    },
    {
      "tool": "device_list_problems",
      "kind": "command",
      "program": "/usr/bin/tur-device",
      "arguments": [{ "literal": "problems" }, { "literal": "--json" }],
      "timeout_seconds": 30
    }
  ]
}
