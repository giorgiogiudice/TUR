{
  "schema_version": 1,
  "service": "org.tur.Diagnostics1",
  "adapters": [
    {
      "tool": "diag_get_status",
      "kind": "command",
      "program": "/usr/bin/tur-diag",
      "arguments": [{ "literal": "status" }, { "literal": "--json" }]
    },
    {
      "tool": "diag_report_prepare",
      "kind": "command",
      "program": "/usr/bin/tur-diag",
      "arguments": [
        { "literal": "report" },
        { "literal": "prepare" },
        { "literal": "--preview" },
        { "literal": "--json" },
        { "literal": "--prepared-by=pax" },
        { "option": "--title", "input": "title" },
        { "option": "--description", "input": "description" },
        { "option": "--component", "input": "component" },
        { "option": "--error-code", "input": "error_code" },
        { "flag": "--from-boot-health", "when": "from_boot_health" }
      ],
      "timeout_seconds": 120,
      "max_output_bytes": 262144
    },
    {
      "tool": "diag_report_list",
      "kind": "command",
      "program": "/usr/bin/tur-diag",
      "arguments": [{ "literal": "report" }, { "literal": "list" }, { "literal": "--json" }]
    }
  ]
}
