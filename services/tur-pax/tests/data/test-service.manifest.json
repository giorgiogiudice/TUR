{
  "schema_version": 1,
  "service": "org.tur.Test1",
  "tools": [
    {
      "name": "test_observe",
      "description": "Read the test value. Changes nothing.",
      "class": 0,
      "method": "GetValue",
      "input_schema": { "type": "object", "properties": {}, "additionalProperties": false }
    },
    {
      "name": "test_reversible",
      "description": "Set the test value. The previous value can be restored.",
      "class": 1,
      "method": "SetValue",
      "input_schema": {
        "type": "object",
        "properties": { "value": { "type": "string", "maxLength": 64 } },
        "required": ["value"],
        "additionalProperties": false
      }
    },
    {
      "name": "test_consequential",
      "description": "Send the test message to a recipient. Cannot be recalled.",
      "class": 2,
      "method": "SendMessage",
      "input_schema": {
        "type": "object",
        "properties": {
          "recipient": { "type": "string", "minLength": 1 },
          "subject": { "type": "string" }
        },
        "required": ["recipient"],
        "additionalProperties": false
      }
    },
    {
      "name": "test_system_critical",
      "description": "Format the test volume. Destroys its contents.",
      "class": 3,
      "method": "FormatVolume",
      "input_schema": {
        "type": "object",
        "properties": { "volume_id": { "type": "string", "minLength": 1 } },
        "required": ["volume_id"],
        "additionalProperties": false
      }
    }
  ]
}
