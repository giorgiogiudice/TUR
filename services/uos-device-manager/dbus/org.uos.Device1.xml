<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0 -->
<!--
  org.uos.Device1: the read-only hardware inventory of the UOS device manager.

  Status: PROPOSED. No service implements this interface yet. It is written
  down so that it can be reviewed and frozen before anything depends on it
  (specification section 16). The contract for each method (authorisation,
  return type, error names, timeout, cancellation) is in
  docs/architecture/device-manager.md, section "D-Bus interface".

  Bus: system. Well-known name: org.uos.Device1. Object: /org/uos/Device1.

  Every method here only reads. There is deliberately no method that binds or
  unbinds a driver, changes who owns a device or hands a device to a guest.
  Hand-off will be a separate interface, with its own review.

  JSON return values are documents of schemas/device-inventory.schema.json;
  the definition used is named with each method.
-->
<node name="/org/uos/Device1">
  <interface name="org.uos.Device1">

    <!--
      The schema_version of the JSON documents this service returns. A client
      that does not know the version must not interpret the documents.
    -->
    <property name="SchemaVersion" type="u" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>

    <!--
      ListDevices: one entry per device.

      options:
        "categories" (as): only devices of these categories. Values are those
                           of the "category" definition of the schema. Absent
                           or empty means every category.
      devices: array of (id, category, name, driver). driver is the empty
               string if no driver is bound or the category has none. The
               entries are the "device_summary" definition of the schema.
    -->
    <method name="ListDevices">
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="devices" type="a(ssss)" direction="out"/>
    </method>

    <!--
      GetDevice: everything known about one device.

      id:      a device identifier from ListDevices or a signal.
      options:
        "include-sensitive" (b): include serial numbers and addresses. Needs
                                 the authorisation described in the design
                                 document. Absent or false: the redacted view.
      device:  a JSON document, the "device_document" definition of the schema.
    -->
    <method name="GetDevice">
      <arg name="id" type="s" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="device" type="s" direction="out"/>
    </method>

    <!--
      GetInventory: the whole inventory, including the platform, firmware
      status and the sources that could not be used.

      options:
        "include-sensitive" (b): as for GetDevice.
      inventory: a JSON document, the root of the schema.
    -->
    <method name="GetInventory">
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="inventory" type="s" direction="out"/>
    </method>

    <!--
      ListProblems: devices with no driver, drivers that did not bind, firmware
      that could not be loaded.

      options: none defined; must be empty.
      problems: array of (code, severity, device_id, category, title,
                user_message, next_step, technical_detail), most severe first.
                device_id and category are empty strings if the device is not
                in the inventory. The entries are the "finding" definition of
                the schema. Findings never hold a sensitive value.
    -->
    <method name="ListProblems">
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="problems" type="a(sssssssa{ss})" direction="out"/>
    </method>

    <!--
      DeviceAdded: a device appeared. The identifier is the one ListDevices
      will return for it.
    -->
    <signal name="DeviceAdded">
      <arg name="id" type="s"/>
      <arg name="category" type="s"/>
    </signal>

    <!--
      DeviceRemoved: a device went away. The identifier is the one it was
      listed under.
    -->
    <signal name="DeviceRemoved">
      <arg name="id" type="s"/>
      <arg name="category" type="s"/>
    </signal>

  </interface>
</node>
