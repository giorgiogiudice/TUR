{
  "licence": "SPDX-License-Identifier: LicenseRef-TUR-Noncommercial-1.0.0",
  "about": "The design tokens of TUR's desktop. The single source of truth: Theme.qml and pax/PaxTheme.qml are generated from this file by gen_tokens.py, the contrast test reads it, and the Plasma colour schemes will be generated from it. Values are those of docs/architecture/desktop-experience.md, section 5; change them there first.",

  "variants": ["dark", "light"],

  "colours": {
    "surface.base":    {"role": "Window background",                          "dark": "#0B0F17", "light": "#F3F5F9"},
    "surface.raised":  {"role": "Lists, cards, text fields",                  "dark": "#131A27", "light": "#FFFFFF"},
    "surface.overlay": {"role": "Menus, dialogs, tooltips, sheets",           "dark": "#1B2434", "light": "#FFFFFF"},
    "surface.sunken":  {"role": "Technical detail, command text",             "dark": "#070A10", "light": "#E7EBF2"},
    "line.subtle":     {"role": "Separators (decoration only)",               "dark": "#27324A", "light": "#D3D9E4"},
    "line.control":    {"role": "Borders of fields, switches, check boxes",   "dark": "#6B7A95", "light": "#6F7C93"},
    "text.primary":    {"role": "Body text, titles",                          "dark": "#EEF1F6", "light": "#10151F"},
    "text.secondary":  {"role": "Supporting text",                            "dark": "#A9B4C6", "light": "#465368"},
    "text.disabled":   {"role": "Unavailable controls",                       "dark": "#657086", "light": "#8A94A6"},
    "accent":          {"role": "Primary button fill, switch on, progress",   "dark": "#2AA9F8", "light": "#0A68C4"},
    "accent.on":       {"role": "Text and icons on accent",                   "dark": "#04111E", "light": "#FFFFFF"},
    "accent.text":     {"role": "Links, focus ring",                          "dark": "#5BBEFF", "light": "#0A5CB0"},
    "selection":       {"role": "Selected row or text",                       "dark": "#1267C4", "light": "#0A68C4"},
    "selection.on":    {"role": "Text on selection",                          "dark": "#FFFFFF", "light": "#FFFFFF"},
    "positive":        {"role": "Works, done",                                "dark": "#4CCB8F", "light": "#157347"},
    "warning":         {"role": "Needs attention; a repair session",          "dark": "#FF9A52", "light": "#A34A00"},
    "negative":        {"role": "Failed; destroys data",                      "dark": "#FF7A7A", "light": "#B3261E"}
  },

  "pax": {
    "about": "Gold is P@x and nothing else. These tokens are generated into the separate module Tur.Kit.Pax, which only P@x's surfaces may import.",
    "colours": {
      "pax":      {"role": "P@x's name, icons and lines on a surface",        "dark": "#E8B44C", "light": "#7A5200"},
      "pax.fill": {"role": "Fill of P@x's pointer, pill and tray glyph",      "dark": "#E8B44C", "light": "#E8B44C"},
      "pax.on":   {"role": "Text and outline on pax.fill",                    "dark": "#1A1204", "light": "#1A1204"}
    },
    "overlay": {
      "about": "Fixed, because the overlay sits over content TUR does not control.",
      "fill": "#E8B44C", "outline": "#0B1220", "hairline": "#FFFFFF", "text": "#1A1204"
    }
  },

  "fixed": {
    "about": "Palettes that do not follow the variant. Held here as data and checked for contrast; the programs that use them (the trusted screen, the boot splash, the high-contrast system surfaces) are later tasks.",
    "trusted":      {"field": "#0A2A4A", "frame": "#C9D1DB", "text": "#EEF1F6", "supporting": "#A9B4C6", "link": "#5BBEFF", "error": "#FF7A7A"},
    "boot":         {"ground": "#000000", "text": "#A9B4C6"},
    "highContrast": {"ground": "#000000", "text": "#FFFFFF", "focus": "#FFE600", "link": "#00E5FF"}
  },

  "type": {
    "interface": "Inter",
    "mono": "JetBrains Mono",
    "lineHeight": 1.4,
    "measure": 72,
    "capsSpacing": 0.08,
    "styles": {
      "display": {"size": 22, "weight": 600, "use": "Setup, installer and trusted-screen titles"},
      "title":   {"size": 15, "weight": 600, "use": "Window and page titles"},
      "heading": {"size": 12, "weight": 600, "use": "Section headings, the title of a sheet or message"},
      "body":    {"size": 10, "weight": 400, "use": "Everything else"},
      "strong":  {"size": 10, "weight": 600, "use": "The one thing in a paragraph that must be seen"},
      "small":   {"size": 9,  "weight": 400, "use": "Supporting lines, captions. Nothing is smaller"},
      "caps":    {"size": 9,  "weight": 600, "use": "Group labels on the trusted screen and the destructive confirmation only (the design's Label style)"},
      "mono":    {"size": 10, "weight": 400, "use": "Technical detail"}
    }
  },

  "space":  {"grid": 4, "related": 8, "group": 16, "margin": 24},
  "radius": {"control": 6, "card": 10, "sheet": 14},
  "target": {"pointer": 36, "touch": 44, "minimum": 24},
  "line":   {"width": 1, "focusWidth": 2, "focusGap": 2},
  "motion": {"control": 120, "appear": 200, "panel": 320, "reducedFade": 100},

  "contrast": {
    "about": "WCAG 2.2 contrast, as section 5.2 of the design tabulates it. 'needs' is text (4.5:1) or boundary (3:1, for the edge of a control and for graphics that carry meaning). 'dark' and 'light' are the ratios the design document states; the check recomputes each and fails if it is below the threshold or differs from the document by more than 0.06. A null means the document gives no figure for that pair and only the threshold applies. Every colour pair a kit component draws must be in this table.",
    "thresholds": {"text": 4.5, "boundary": 3.0},
    "pairs": [
      {"fg": "text.primary",   "bg": "surface.base",    "needs": "text",     "dark": 16.9, "light": 16.7},
      {"fg": "text.primary",   "bg": "surface.raised",  "needs": "text",     "dark": 15.4, "light": 18.3},
      {"fg": "text.primary",   "bg": "surface.overlay", "needs": "text",     "dark": 13.8, "light": 18.3},
      {"fg": "text.primary",   "bg": "surface.sunken",  "needs": "text",     "dark": 17.5, "light": 15.3},
      {"fg": "text.secondary", "bg": "surface.base",    "needs": "text",     "dark": 9.2,  "light": 7.1},
      {"fg": "text.secondary", "bg": "surface.raised",  "needs": "text",     "dark": 8.3,  "light": 7.8},
      {"fg": "text.secondary", "bg": "surface.overlay", "needs": "text",     "dark": 7.4,  "light": 7.8},
      {"fg": "text.secondary", "bg": "surface.sunken",  "needs": "text",     "dark": 9.5,  "light": 6.5},
      {"fg": "accent.text",    "bg": "surface.base",    "needs": "text",     "dark": 9.4,  "light": 6.1},
      {"fg": "accent.text",    "bg": "surface.raised",  "needs": "text",     "dark": 8.5,  "light": 6.6},
      {"fg": "accent.text",    "bg": "surface.overlay", "needs": "text",     "dark": 7.6,  "light": 6.6},
      {"fg": "positive",       "bg": "surface.base",    "needs": "text",     "dark": 9.4,  "light": 5.4},
      {"fg": "positive",       "bg": "surface.raised",  "needs": "text",     "dark": 8.5,  "light": 5.9},
      {"fg": "positive",       "bg": "surface.overlay", "needs": "text",     "dark": 7.6,  "light": 5.9},
      {"fg": "warning",        "bg": "surface.base",    "needs": "text",     "dark": 9.1,  "light": 5.4},
      {"fg": "warning",        "bg": "surface.raised",  "needs": "text",     "dark": 8.3,  "light": 5.9},
      {"fg": "warning",        "bg": "surface.overlay", "needs": "text",     "dark": 7.4,  "light": 5.9},
      {"fg": "negative",       "bg": "surface.base",    "needs": "text",     "dark": 7.6,  "light": 6.0},
      {"fg": "negative",       "bg": "surface.raised",  "needs": "text",     "dark": 6.9,  "light": 6.5},
      {"fg": "negative",       "bg": "surface.overlay", "needs": "text",     "dark": 6.2,  "light": 6.5},
      {"fg": "line.control",   "bg": "surface.base",    "needs": "boundary", "dark": 4.4,  "light": 3.9},
      {"fg": "line.control",   "bg": "surface.raised",  "needs": "boundary", "dark": 4.0,  "light": 4.2},
      {"fg": "line.control",   "bg": "surface.overlay", "needs": "boundary", "dark": 3.6,  "light": 4.2},
      {"fg": "accent",         "bg": "surface.base",    "needs": "boundary", "dark": 7.4,  "light": 5.1},
      {"fg": "accent",         "bg": "surface.raised",  "needs": "boundary", "dark": 6.8,  "light": 5.5},
      {"fg": "accent",         "bg": "surface.overlay", "needs": "boundary", "dark": 6.0,  "light": 5.5},
      {"fg": "selection",      "bg": "surface.base",    "needs": "boundary", "dark": 3.4,  "light": 5.1},
      {"fg": "selection",      "bg": "surface.raised",  "needs": "boundary", "dark": 3.1,  "light": 5.5},
      {"fg": "accent.on",      "bg": "accent",          "needs": "text",     "dark": 7.4,  "light": 5.5},
      {"fg": "selection.on",   "bg": "selection",       "needs": "text",     "dark": 5.6,  "light": 5.5},
      {"fg": "pax",            "bg": "surface.base",    "needs": "text",     "dark": 10.1, "light": 6.3},
      {"fg": "pax",            "bg": "surface.raised",  "needs": "text",     "dark": 9.2,  "light": 6.9},
      {"fg": "pax",            "bg": "surface.overlay", "needs": "text",     "dark": 8.2,  "light": 6.9},
      {"fg": "pax.on",         "bg": "pax.fill",        "needs": "text",     "dark": 9.8,  "light": 9.8}
    ],
    "fixedPairs": [
      {"palette": "pax.overlay",  "fg": "outline",    "bg": "fill",   "needs": "boundary", "ratio": 9.9},
      {"palette": "pax.overlay",  "fg": "text",       "bg": "fill",   "needs": "text",     "ratio": 9.8},
      {"palette": "trusted",      "fg": "text",       "bg": "field",  "needs": "text",     "ratio": 12.9},
      {"palette": "trusted",      "fg": "supporting", "bg": "field",  "needs": "text",     "ratio": 7.0},
      {"palette": "trusted",      "fg": "frame",      "bg": "field",  "needs": "boundary", "ratio": 9.4},
      {"palette": "trusted",      "fg": "link",       "bg": "field",  "needs": "text",     "ratio": 7.1},
      {"palette": "trusted",      "fg": "error",      "bg": "field",  "needs": "text",     "ratio": 5.8},
      {"palette": "boot",         "fg": "text",       "bg": "ground", "needs": "text",     "ratio": null},
      {"palette": "highContrast", "fg": "text",       "bg": "ground", "needs": "text",     "ratio": 21.0},
      {"palette": "highContrast", "fg": "focus",      "bg": "ground", "needs": "text",     "ratio": 16.6},
      {"palette": "highContrast", "fg": "link",       "bg": "ground", "needs": "text",     "ratio": 13.7}
    ],
    "exempt": [
      {"fg": "text.disabled", "why": "WCAG 2.2 exempts inactive controls from 1.4.3 and 1.4.11. The design states 3.9 (dark) and 2.8 (light) on surface.base.", "dark": 3.9, "light": 2.8},
      {"fg": "line.subtle",   "why": "Decoration only: nothing is understood through a separator.", "dark": null, "light": null}
    ],
    "forbidden": [
      {"fg": "selection", "bg": "surface.overlay", "variant": "dark", "why": "2.8:1. Menus and sheets mark the current item with accent (6.0:1) instead; ListRow has onOverlay for this."}
    ]
  }
}
