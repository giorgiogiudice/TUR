# --- KDE Frameworks that are LGPL throughout their shipped code -------------
#
# Kirigami is for the programs inside the session. tur-kit itself must work
# with nothing from KDE (the trusted screen and the installer use it), so
# Kirigami is refused under desktop/kit. The toolchain proof imports it to
# find out what it reports.

allow qml org.kde.kirigami        desktop/**,!desktop/kit/**   LGPL-2.0-or-later

# --- TUR's own -------------------------------------------------------------

allow qml Tur.Kit                 desktop/**                   LicenseRef-TUR-Noncommercial-1.0.0
allow qml Tur.Kit.Gallery         desktop/kit/gallery/**,desktop/kit/tests/**   LicenseRef-TUR-Noncommercial-1.0.0
allow cmake turkit                desktop/**                   LicenseRef-TUR-Noncommercial-1.0.0
allow cmake turkitgallery         desktop/kit/**               LicenseRef-TUR-Noncommercial-1.0.0
allow soname libturkit.so*        *                            LicenseRef-TUR-Noncommercial-1.0.0
allow soname libturkitgallery.so* *                            LicenseRef-TUR-Noncommercial-1.0.0

# The application centre, tur-centre (design, section 8; task D-10): its own
# QML module and library, under the project licence. It adds no dependency:
# it links Qt Core, Gui, Qml and Quick and the kit, all allowed above, and
# talks to the catalogue by running `tur-catalogue` as a separate program
# (QProcess, in Qt Core), which is the command-line side of the boundary.
allow qml Tur.Centre              desktop/apps/tur-centre/**   LicenseRef-TUR-Noncommercial-1.0.0
allow cmake turcentre             desktop/apps/tur-centre/**   LicenseRef-TUR-Noncommercial-1.0.0
allow soname libturcentre.so*     *                            LicenseRef-TUR-Noncommercial-1.0.0

# TUR's settings, tur-settings (design, section 10; task D-07): its own QML
# module and library, under the project licence. It adds one dependency that
# was already allowed above and not yet used: Qt D-Bus (LGPL-3.0-only), for
# org.tur.Settings1 and org.tur.Addressable1 on the session bus. It starts
# KDE System Settings as a separate program (QProcess, in Qt Core) and links
# nothing of KDE's.
allow qml Tur.Settings            desktop/apps/tur-settings/** LicenseRef-TUR-Noncommercial-1.0.0
allow cmake tursettings           desktop/apps/tur-settings/** LicenseRef-TUR-Noncommercial-1.0.0
allow soname libtursettings.so*   *                            LicenseRef-TUR-Noncommercial-1.0.0

# The highlight that tur-settings draws round a row is gold when the
# assistant asked for the row, and only then (design, sections 5.1 and 9.5:
# TUR's own programs draw P@x's highlight themselves). One file may import
# the gold tokens for that, and the program links the module that holds them.
# Its tests read the same token, to check the colour of the line.
allow qml Tur.Kit.Pax             desktop/apps/tur-settings/qml/RowHighlight.qml,desktop/apps/tur-settings/tests/**   LicenseRef-TUR-Noncommercial-1.0.0
allow cmake turkitpax             desktop/apps/tur-settings/**   LicenseRef-TUR-Noncommercial-1.0.0

# Gold is P@x and nothing else (design, section 5.1). The gold tokens and the
# components drawn in them are the module Tur.Kit.Pax; only P@x's surfaces,
# the gallery and the tests may import it.
allow qml Tur.Kit.Pax             desktop/kit/pax/**,desktop/kit/gallery/**,desktop/kit/tests/**,desktop/apps/pax-ui/**,desktop/apps/tur-pax-ui/**,desktop/apps/pax-overlay/**,desktop/apps/tur-pax-overlay/**,desktop/apps/pax-approve/**   LicenseRef-TUR-Noncommercial-1.0.0
allow cmake turkitpax             desktop/kit/**,desktop/apps/pax-ui/**,desktop/apps/tur-pax-ui/**,desktop/apps/pax-overlay/**,desktop/apps/tur-pax-overlay/**,desktop/apps/pax-approve/**   LicenseRef-TUR-Noncommercial-1.0.0
allow soname libturkitpax.so*     *                            LicenseRef-TUR-Noncommercial-1.0.0

# P@x's overlay, tur-pax-overlay (design, sections 9.3 to 9.6; task D-15):
# its own QML module and library, under the project licence, and two
# libraries of KDE's, linked dynamically by the program (not by its module),
# whose licences were read file by file at the Plasma/6.8 tags (v6.8.2) on
# 12 November 2026 (docs/architecture/tur-pax-overlay.md, section 8):
#  - LayerShellQt: every source file of src/ is "LGPL-2.1-only OR
#    LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL"; its protocol file is MIT;
#    its build files BSD-3-Clause. For the overlay's layer-shell surfaces.
#  - KWayland's client library: all 75 files of src/client are "LGPL-2.1-only
#    OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL"; the protocol files it
#    is generated from (plasma-wayland-protocols 1.23.0,
#    plasma-window-management.xml and fake-input.xml) are LGPL-2.1-or-later.
#    For the Plasma window-management protocol: where other programs' windows
#    are. The compositor tests also use its fake-input protocol to inject
#    input; the overlay never does.
allow qml Tur.PaxOverlay          desktop/apps/tur-pax-overlay/**   LicenseRef-TUR-Noncommercial-1.0.0
allow cmake turpaxoverlay         desktop/apps/tur-pax-overlay/**,desktop/tests/compositor/**   LicenseRef-TUR-Noncommercial-1.0.0
allow soname libturpaxoverlay.so* *                            LicenseRef-TUR-Noncommercial-1.0.0
allow cmake LayerShellQt          desktop/apps/tur-pax-overlay/CMakeLists.txt   LGPL-2.1-only OR LGPL-3.0-only
allow cmake LayerShellQt::Interface desktop/apps/tur-pax-overlay/CMakeLists.txt LGPL-2.1-only OR LGPL-3.0-only
allow soname libLayerShellQtInterface.so.6 *                   LGPL-2.1-only OR LGPL-3.0-only
allow cmake KWayland              desktop/apps/tur-pax-overlay/CMakeLists.txt   LGPL-2.1-only OR LGPL-3.0-only
allow cmake Plasma::KWaylandClient desktop/apps/tur-pax-overlay/CMakeLists.txt,desktop/tests/compositor/CMakeLists.txt   LGPL-2.1-only OR LGPL-3.0-only
allow soname libKWaylandClient.so.6 *                          LGPL-2.1-only OR LGPL-3.0-only

# P@x's window, tur-pax-ui (design, sections 9.1, 9.2 and 9.12; task D-17):
# its own QML module and library, under the project licence. It talks to
# P@x's service, org.tur.Agent1, and offers org.tur.PaxUi1, over Qt D-Bus
# (LGPL-3.0-only), allowed above. The program links one library of KDE's,
# dynamically, by the program and not by its module: LayerShellQt, for the
# layer-shell surface of the ask bar and the panel (design 9.2). Its licence
# was read file by file at the Plasma/6.8 tags (v6.8.2) for the overlay on
# 12 November 2026 (docs/architecture/tur-pax-overlay.md, section 8): every
# source file of src/ is "LGPL-2.1-only OR LGPL-3.0-only OR
# LicenseRef-KDE-Accepted-LGPL"; its protocol file is MIT. The stand-in for
# org.tur.Agent1 its tests start (tests/fixture) links Qt Core and Qt D-Bus.
allow qml Tur.PaxUi               desktop/apps/tur-pax-ui/**   LicenseRef-TUR-Noncommercial-1.0.0
allow cmake turpaxui              desktop/apps/tur-pax-ui/**   LicenseRef-TUR-Noncommercial-1.0.0
allow soname libturpaxui.so*      *                            LicenseRef-TUR-Noncommercial-1.0.0
allow cmake LayerShellQt          desktop/apps/tur-pax-ui/CMakeLists.txt   LGPL-2.1-only OR LGPL-3.0-only
allow cmake LayerShellQt::Interface desktop/apps/tur-pax-ui/CMakeLists.txt LGPL-2.1-only OR LGPL-3.0-only

# TUR's graphical installer, tur-installer (design, section 11.5; task D-23;
# ADR-0018, amendment of 13 November 2026): its own QML module and library,
# under the project licence. It adds no library: Qt D-Bus (LGPL-3.0-only),
# already allowed above, sends KConfig's change notification for the keyboard
# layout, and the installation engine is a separate program it starts through
# pkexec (QProcess, in Qt Core), which is the command-line side of the
# boundary. It uses Qt Quick Controls' ComboBox, allowed above, for the
# keyboard layout.
allow qml Tur.Installer           desktop/apps/tur-installer/**   LicenseRef-TUR-Noncommercial-1.0.0
allow cmake turinstaller          desktop/apps/tur-installer/**   LicenseRef-TUR-Noncommercial-1.0.0
allow soname libturinstaller.so*  *                               LicenseRef-TUR-Noncommercial-1.0.0

# And blue is the system: what is drawn in P@x's module does not use the
# system's accent.
deny-text desktop/kit/pax/*.qml  Theme\.(accent|selection)  blue is the system's colour; P@x's components are gold (design, 5.1)

