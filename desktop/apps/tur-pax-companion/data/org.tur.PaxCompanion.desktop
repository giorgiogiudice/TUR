#
# The launcher entry of P@x's character on the bar (docs/architecture/
# tur-pax-companion.md, section 5): how a person brings the character back
# after hiding it, and how they reach it with the keyboard alone. Opening
# the entry puts the character back on the bar; its action gives it the
# keyboard (what it is saying, or its menu; Esc gives the keyboard back).
#
# No key is bound here. A key for "Go to P@x on the bar" would be a fifth
# command in desktop/kit/pax/commands.json, which is the owner's to choose
# (tur-pax-companion.md, section 9).
# Installed as /usr/share/applications/org.tur.PaxCompanion.desktop.
[Desktop Entry]
Type=Application
Version=1.5
Name=P@x on the bar
GenericName=Assistant
Comment=Show TUR's assistant on the bar, where it says what it is doing and what happened
Exec=tur-pax-companion --show
Icon=org.tur.Pax
Terminal=false
Categories=Utility;
Keywords=assistant;P@x;pax;character;companion;bar;panel;quiet;
StartupNotify=false
SingleMainWindow=true
Actions=attend;hide;

[Desktop Action attend]
Name=Go to P@x on the bar
Exec=tur-pax-companion --attend

[Desktop Action hide]
Name=Hide P@x from the bar
Exec=tur-pax-companion --hide
