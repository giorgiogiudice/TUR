    { "page": "tur.storage", "title": "Storage", "path": ["Storage"], "status": "planned" },
    { "page": "tur.devices", "title": "Devices", "path": ["Devices"], "status": "planned" },
    { "page": "tur.pax.general", "title": "General", "path": ["P@x", "General"], "status": "planned" },
    { "page": "tur.pax.voice", "title": "Voice", "path": ["P@x", "Voice"], "status": "planned" },
    { "page": "tur.pax.privacy", "title": "Privacy", "path": ["P@x", "Privacy"], "status": "planned" },
    { "page": "tur.pax.approvals", "title": "Approvals", "path": ["P@x", "Approvals"], "status": "planned" },
    { "page": "tur.pax.memory", "title": "Memory", "path": ["P@x", "Memory"], "status": "planned" },
    { "page": "tur.pax.schedules", "title": "Schedules", "path": ["P@x", "Schedules"], "status": "planned" },
    { "page": "tur.pax.spending", "title": "Spending", "path": ["P@x", "Spending"], "status": "planned" },
    { "page": "tur.pax.activity", "title": "Activity", "path": ["P@x", "Activity"], "status": "planned" },
    { "page": "tur.diagnostics", "title": "Diagnostics", "path": ["Diagnostics"], "status": "planned" },
    {
      "page": "tur.appearance",
      "title": "Appearance",
      "path": ["Appearance"],
      "keywords": ["look", "theme", "colours", "colors", "style"],
      "sections": [
        { "id": "variant", "title": "Light or dark" },
        { "id": "kde", "title": "Everything else" }
      ],
      "rows": [
        {
          "id": "current",
          "title": "The desktop is set to",
          "keywords": ["current theme", "dark or light", "which mode"],
          "kind": "information",
          "section": "variant",
          "source": { "type": "platform", "available": true, "hint": "colour-scheme" }
        },
        {
          "id": "variant",
          "title": "Dark, light, or light by day and dark at night",
          "keywords": ["dark mode", "light mode", "night mode", "dark theme", "light theme", "automatic", "day and night"],
          "kind": "choice",
          "section": "variant",
          "source": {
            "type": "kde-config",
            "available": false,
            "waits_for": "TUR's two global themes (task D-04)",
            "file": "kdeglobals",
            "group": "KDE",
            "key": "LookAndFeelPackage"
          },
          "change": { "class": 1 }
        },
        {
          "id": "global-theme",
          "title": "Global theme",
          "keywords": ["theme", "look and feel", "skin"],
          "kind": "action",
          "section": "kde",
          "source": { "type": "address", "available": true, "opens": "kde.kcm_lookandfeel" },
          "change": { "class": 1 }
        },
        {
          "id": "colours",
          "title": "Colours",
          "keywords": ["colors", "colour scheme", "color scheme", "accent colour", "accent color", "contrast"],
          "kind": "action",
          "section": "kde",
          "source": { "type": "address", "available": true, "opens": "kde.kcm_colors" },
          "change": { "class": 1 }
        },
        {
          "id": "fonts",
          "title": "Fonts",
          "keywords": ["font size", "text size", "typeface", "bigger text"],
          "kind": "action",
          "section": "kde",
          "source": { "type": "address", "available": true, "opens": "kde.kcm_fonts" },
          "change": { "class": 1 }
        },
        {
          "id": "night-light",
          "title": "Night Light",
          "keywords": ["blue light", "warm colours", "warm colors", "evening", "colour temperature", "color temperature"],
          "kind": "action",
          "section": "kde",
          "source": { "type": "address", "available": true, "opens": "kde.kcm_nightlight" },
          "change": { "class": 1 }
        }
      ]
    },
