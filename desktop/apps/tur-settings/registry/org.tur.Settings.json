{
  "licence": "SPDX-License-Identifier: LicenseRef-TUR-Noncommercial-1.0.0",
  "schema_version": 1,
  "program": "org.tur.Settings",
  "pages": [
    {
      "page": "tur.overview",
      "title": "Overview",
      "path": ["Overview"],
      "keywords": ["status", "summary", "state of the system", "home"],
      "sections": [
        { "id": "system", "title": "This system" },
        { "id": "state", "title": "State of the system" }
      ],
      "rows": [
        {
          "id": "version",
          "title": "Version",
          "keywords": ["release", "which version", "version number"],
          "kind": "information",
          "section": "system",
          "source": { "type": "file", "available": true, "path": "/usr/lib/tur/release", "key": "TUR_VERSION" }
        },
        {
          "id": "build",
          "title": "Build",
          "keywords": ["build number", "image", "build identifier"],
          "kind": "information",
          "section": "system",
          "source": { "type": "file", "available": true, "path": "/usr/lib/tur/release", "key": "TUR_BUILD_ID" }
        },
        {
          "id": "update-state",
          "title": "Updates",
          "keywords": ["up to date", "new version", "upgrade"],
          "kind": "information",
          "section": "state",
          "source": {
            "type": "dbus",
            "available": false,
            "waits_for": "The update service, org.tur.Update1 (task D-09)",
            "bus": "system",
            "service": "org.tur.Update1"
          }
        },
        {
          "id": "last-start",
          "title": "The last start",
          "keywords": ["boot", "startup", "health", "rollback", "went back"],
          "kind": "information",
          "section": "state",
          "source": {
            "type": "command",
            "available": false,
            "waits_for": "tur-boot-health in the image (boot health and rollback)",
            "program": "/usr/bin/tur-boot-health",
            "arguments": ["status", "--json"]
          }
        },
        {
          "id": "attention",
          "title": "Needs attention",
          "keywords": ["problems", "warnings", "something wrong", "alerts"],
          "kind": "information",
          "section": "state",
          "source": {
            "type": "program",
            "available": false,
            "waits_for": "The services that report problems: updates, boot health, storage and devices",
            "what": "attention-list"
          }
        }
      ]
    },
    { "page": "tur.updates", "title": "Updates", "path": ["Updates"], "status": "planned" },
    { "page": "tur.recovery", "title": "Recovery", "path": ["Recovery"], "status": "planned" },
