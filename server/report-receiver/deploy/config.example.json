{
  "listen": "127.0.0.1:8470",
  "public_url": "https://reports.example.org",
  "data_dir": "/var/lib/tur-report-receiver",
  "keys_dir": "/etc/tur-report-receiver/keys",
  "current_key": "2026-11",
  "retention_days": 90,
  "status_retention_days": 365,
  "limits": {
    "max_upload_bytes": 8388608,
    "max_unpacked_bytes": 67108864,
    "uploads_per_address_per_hour": 6,
    "uploads_per_hour": 120,
    "lookups_per_address_per_hour": 120,
    "max_concurrent_uploads": 2
  },
  "github": {
    "api_url": "https://api.github.com",
    "repository": "OWNER/tur-problem-reports",
    "token_file": "/etc/tur-report-receiver/github-token",
    "labels": ["problem-report"]
  },
  "proxy": {
    "trusted": ["127.0.0.1", "::1"]
  },
  "timing": {
    "file_interval_seconds": 30,
    "retry_initial_seconds": 60,
    "retry_max_seconds": 3600,
    "sweep_interval_seconds": 3600,
    "upload_timeout_seconds": 120
  }
}
