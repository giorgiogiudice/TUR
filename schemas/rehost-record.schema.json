{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/giorgiogiudice/TUR/schemas/rehost-record.schema.json",
  "$comment": "SPDX-License-Identifier: LicenseRef-TUR-Noncommercial-1.0.0. The record of a re-hosted application, apps/<app-id>/record.json, written by tur-rehost (docs/architecture/rehost.md, section 7). A unit test in services/tur-rehost/src/record.rs keeps the property names in step with the Rust types.",
  "title": "TUR re-hosted application record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "app_id", "name", "app_version", "runtime", "package", "program", "payload",
    "payload_sha256", "fuses_publisher", "fuses_set", "modules", "system_helpers", "fetched",
    "updater", "installed_at", "desktop_entry"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "app_id": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$", "maxLength": 255 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "app_version": { "type": ["string", "null"] },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "version", "url", "sha256", "codecs"],
      "properties": {
        "family": { "enum": ["electron"] },
        "version": { "type": "string" },
        "url": { "type": "string", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "codecs": { "enum": ["upstream", "open-only"] }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "size", "sha256", "platform", "layers"],
      "properties": {
        "file_name": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^([0-9a-f]{64})?$" },
        "platform": { "enum": ["windows", "macos", "linux", "any", "unknown"] },
        "layers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "program": { "type": "string" },
    "payload": { "type": "string" },
    "payload_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "fuses_publisher": { "type": "object", "additionalProperties": { "enum": ["0", "1", "r"] } },
    "fuses_set": { "type": "object", "additionalProperties": { "type": "string" } },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "resolution", "applied"],
        "properties": {
          "module": { "type": "string" },
          "resolution": { "enum": ["not-for-linux", "carried", "npm-package", "npm-prebuild", "release-prebuild", "source-build", "needs-build", "unresolved"] },
          "applied": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "system_helpers": { "type": "array", "items": { "type": "string" } },
    "fetched": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["what", "url", "sha256", "size", "licence"],
        "properties": {
          "what": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1 },
          "licence": { "type": ["string", "null"] }
        }
      }
    },
    "updater": { "const": "off" },
    "installed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "desktop_entry": { "type": "string" }
  }
}
