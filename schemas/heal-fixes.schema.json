{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/giorgiogiudice/TUR/schemas/heal-fixes.schema.json",
  "$comment": "SPDX-License-Identifier: LicenseRef-TUR-Noncommercial-1.0.0",
  "title": "TUR fixed fault codes",
  "description": "The fault codes a TUR image addresses (/usr/share/tur/heal/fixes.json; docs/architecture/self-healing.md, section 7). A change that fixes a fault the healing service finds adds the fault's code here. After an update the service checks the fault again: gone, the person is told it is fixed; back, a report is offered again.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixes"],
  "properties": {
    "schema_version": { "const": 1 },
    "about": { "type": "string" },
    "fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "summary"],
        "properties": {
          "code": { "type": "string", "pattern": "^TUR-[A-Z]+(-[A-Z0-9]+)*-[0-9]{3}$" },
          "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
          "change": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
