    "finding": {
      "description": "One problem found in the inventory, in the two layers of specification section 6.3.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "title",
        "device_id",
        "category",
        "user_message",
        "next_step",
        "technical_detail"
      ],
      "properties": {
        "code": {
          "description": "The stable error code.",
          "type": "string",
          "pattern": "^UOS-DEVICE-[A-Z0-9]+-[0-9]{3}$"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "title": {
          "type": "string"
        },
        "device_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/device_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "category": {
          "oneOf": [
            {
              "$ref": "#/$defs/category"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_message": {
          "description": "What happened, for the user.",
          "type": "string"
        },
        "next_step": {
          "description": "What the user can do next.",
          "type": "string"
        },
        "technical_detail": {
          "description": "Identifiers and evidence, for a developer.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
