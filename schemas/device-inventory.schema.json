{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/giorgiogiudice/UOS/schemas/device-inventory.schema.json",
  "title": "UOS device inventory",
  "description": "The read-only hardware inventory printed by `uos-device inventory --json` and returned by org.uos.Device1.GetInventory. Every field is always present; null means the value could not be read or does not exist. The other documents of the device manager are defined under $defs: problem_report, device_summary and device_document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "redacted",
    "platform",
    "pci",
    "usb",
    "network",
    "audio",
    "storage_controllers",
    "block",
    "input",
    "bluetooth",
    "cameras",
    "thunderbolt",
    "firmware",
    "kernel",
    "source_notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "redacted": {
      "description": "true if sensitive values have been removed.",
      "type": "boolean"
    },
    "platform": {
      "$ref": "#/$defs/platform"
    },
    "pci": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pci_device"
      }
    },
    "usb": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/usb_device"
      }
    },
    "network": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/network_interface"
      }
    },
    "audio": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/audio_card"
      }
    },
    "storage_controllers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/storage_controller"
      }
    },
    "block": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block_device"
      }
    },
    "input": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input_device"
      }
    },
    "bluetooth": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bluetooth_adapter"
      }
    },
    "cameras": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/camera"
      }
    },
    "thunderbolt": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/thunderbolt_device"
      }
    },
    "firmware": {
      "$ref": "#/$defs/firmware"
    },
    "kernel": {
      "$ref": "#/$defs/kernel_evidence"
    },
    "source_notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_note"
      }
    }
  },
  "$defs": {
    "text": {
      "description": "Text read from the system: no control characters, at most 256 characters; longer text is cut and ends in an ellipsis.",
      "type": "string",
      "maxLength": 256
    },
    "optional_text": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "optional_name": {
      "description": "A driver, module or kernel device name, or null.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:+@-]+$"
    },
    "hex2": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{2}$"
    },
    "hex4": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{4}$"
    },
    "hex6": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{6}$"
    },
    "device_id": {
      "description": "A stable device identifier. It never contains a serial number or address: where it is derived from one, that value is hashed with the machine identifier.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9:._~-]+$"
    },
    "sysfs_path": {
      "description": "The device's directory in sysfs (for a sound card known only to procfs, under /proc/asound).",
      "type": "string",
      "maxLength": 512
    },
    "modalias": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    },
    "id_basis": {
      "description": "What the identifier is derived from. hardware_identifier: a serial number, permanent MAC address, WWN or UUID, hashed; follows the device to another port. topology: the device's position; lost if the device is moved. kernel_name: a kernel-assigned name only; not stable.",
      "enum": [
        "hardware_identifier",
        "topology",
        "kernel_name"
      ]
    },
    "category": {
      "description": "The kind of device.",
      "enum": [
        "pci",
        "usb",
        "network",
        "audio",
        "storage_controller",
        "block",
        "input",
        "bluetooth",
        "camera",
        "thunderbolt"
      ]
    },
    "sensitive": {
      "description": "A value that identifies a person's hardware (serial number, MAC address, UUID). Always an object with sensitive: true, so that a consumer can recognise and redact it without knowing this schema. value is null if the hardware gave none, if it could not be read, or if it has been redacted.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensitive",
        "redacted",
        "value"
      ],
      "properties": {
        "sensitive": {
          "const": true
        },
        "redacted": {
          "description": "true if a value existed and has been removed.",
          "type": "boolean"
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "module_match": {
      "description": "A kernel module whose alias table matches a device.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "loaded"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:+@-]+$"
        },
        "loaded": {
          "description": "Whether /sys/module/<name> exists.",
          "type": "boolean"
        }
      }
    },
    "drm_connector": {
      "description": "A display connector.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "enabled"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "connected",
            "disconnected",
            "unknown"
          ]
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "drm_card": {
      "description": "A DRM card.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "connectors"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "connectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/drm_connector"
          }
        }
      }
    },
    "gpu": {
      "description": "Display details of a display-class PCI device.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boot_vga",
        "drm_cards"
      ],
      "properties": {
        "boot_vga": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "drm_cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/drm_card"
          }
        }
      }
    },
    "pci_device": {
      "description": "A PCI or PCI Express function.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "id_basis",
        "sysfs_path",
        "address",
        "vendor_id",
        "device_id",
        "class",
        "class_name",
        "subsystem_vendor_id",
        "subsystem_device_id",
        "revision",
        "vendor_name",
        "device_name",
        "driver",
        "modalias",
        "kernel_modules",
        "gpu"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/device_id"
        },
        "id_basis": {
          "$ref": "#/$defs/id_basis"
        },
        "sysfs_path": {
          "$ref": "#/$defs/sysfs_path"
        },
        "address": {
          "type": "string",
          "pattern": "^[0-9a-f]{4,8}:[0-9a-f]{2}:[0-9a-f]{2}\\.[0-9a-f]$"
        },
        "vendor_id": {
          "$ref": "#/$defs/hex4"
        },
        "device_id": {
          "$ref": "#/$defs/hex4"
        },
        "class": {
          "$ref": "#/$defs/hex6"
        },
        "class_name": {
          "$ref": "#/$defs/optional_text"
        },
        "subsystem_vendor_id": {
          "$ref": "#/$defs/hex4"
        },
        "subsystem_device_id": {
          "$ref": "#/$defs/hex4"
        },
        "revision": {
          "$ref": "#/$defs/hex2"
        },
        "vendor_name": {
          "$ref": "#/$defs/optional_text"
        },
        "device_name": {
          "$ref": "#/$defs/optional_text"
        },
        "driver": {
          "$ref": "#/$defs/optional_name"
        },
        "modalias": {
          "$ref": "#/$defs/modalias"
        },
        "kernel_modules": {
          "description": "Kernel modules whose aliases match the modalias. null if the kernel's alias table could not be read.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/module_match"
          }
        },
        "gpu": {
          "oneOf": [
            {
              "$ref": "#/$defs/gpu"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "usb_interface": {
      "description": "One interface of a USB device.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "class",
        "subclass",
        "protocol",
        "class_name",
        "driver",
        "modalias",
        "kernel_modules"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "class": {
          "$ref": "#/$defs/hex2"
        },
        "subclass": {
          "$ref": "#/$defs/hex2"
        },
        "protocol": {
          "$ref": "#/$defs/hex2"
        },
        "class_name": {
          "$ref": "#/$defs/optional_text"
        },
        "driver": {
          "$ref": "#/$defs/optional_name"
        },
        "modalias": {
          "$ref": "#/$defs/modalias"
        },
        "kernel_modules": {
          "description": "Kernel modules whose aliases match the modalias. null if the kernel's alias table could not be read.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/module_match"
          }
        }
      }
    },
    "usb_device": {
      "description": "A USB device. manufacturer, product and serial are supplied by the device itself.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "id_basis",
        "sysfs_path",
        "bus_port",
        "vendor_id",
        "product_id",
        "class",
        "class_name",
        "manufacturer",
        "product",
        "serial",
        "speed_mbps",
        "usb_version",
        "removable",
        "is_root_hub",
        "interfaces"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/device_id"
        },
        "id_basis": {
          "$ref": "#/$defs/id_basis"
        },
        "sysfs_path": {
          "$ref": "#/$defs/sysfs_path"
        },
        "bus_port": {
          "$ref": "#/$defs/text"
        },
        "vendor_id": {
          "$ref": "#/$defs/hex4"
        },
        "product_id": {
          "$ref": "#/$defs/hex4"
        },
        "class": {
          "$ref": "#/$defs/hex2"
        },
        "class_name": {
          "$ref": "#/$defs/optional_text"
        },
        "manufacturer": {
          "$ref": "#/$defs/optional_text"
        },
        "product": {
          "$ref": "#/$defs/optional_text"
        },
        "serial": {
          "$ref": "#/$defs/sensitive"
        },
        "speed_mbps": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9.]{1,8}$"
        },
        "usb_version": {
          "$ref": "#/$defs/optional_text"
        },
        "removable": {
          "enum": [
            "removable",
            "fixed",
            "unknown"
          ]
        },
        "is_root_hub": {
          "type": "boolean"
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/usb_interface"
          }
        }
      }
    },
    "network_interface": {
      "description": "A network interface.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "id_basis",
        "sysfs_path",
        "name",
        "kind",
        "wireless",
        "is_virtual",
        "link_type",
        "driver",
        "operstate",
        "mac_address",
        "parent"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/device_id"
        },
        "id_basis": {
          "$ref": "#/$defs/id_basis"
        },
        "sysfs_path": {
          "$ref": "#/$defs/sysfs_path"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "enum": [
            "ethernet",
            "wireless",
            "loopback",
            "bridge",
            "wwan",
            "virtual",
            "other"
          ]
        },
        "wireless": {
          "type": "boolean"
        },
        "is_virtual": {
          "type": "boolean"
        },
        "link_type": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "driver": {
          "$ref": "#/$defs/optional_name"
        },
        "operstate": {
          "enum": [
            "up",
            "down",
            "dormant",
            "lower_layer_down",
            "not_present",
            "testing",
            "unknown"
          ]
        },
        "mac_address": {
          "$ref": "#/$defs/sensitive"
        },
        "parent": {
          "oneOf": [
            {
              "$ref": "#/$defs/device_id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "audio_card": {
      "description": "A sound card.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "id_basis",
        "sysfs_path",
        "index",
        "card_id",
        "name",
        "long_name",
        "alsa_driver",
        "driver",
        "parent"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/device_id"
        },
        "id_basis": {
          "$ref": "#/$defs/id_basis"
        },
        "sysfs_path": {
          "$ref": "#/$defs/sysfs_path"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "card_id": {
          "$ref": "#/$defs/optional_text"
        },
        "name": {
          "$ref": "#/$defs/optional_text"
        },
        "long_name": {
          "$ref": "#/$defs/optional_text"
        },
        "alsa_driver": {
          "$ref": "#/$defs/optional_text"
        },
        "driver": {
          "$ref": "#/$defs/optional_name"
        },
        "parent": {
          "oneOf": [
            {
              "$ref": "#/$defs/device_id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "storage_controller": {
      "description": "A storage controller: a view of a PCI function of the mass-storage class or of a USB mass-storage interface.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "id_basis",
        "sysfs_path",
        "kind",
        "driver",
        "parent"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/device_id"
        },
        "id_basis": {
          "$ref": "#/$defs/id_basis"
        },
        "sysfs_path": {
          "$ref": "#/$defs/sysfs_path"
        },
        "kind": {
          "enum": [
            "nvme",
            "sata",
            "ata",
            "scsi",
            "sas",
            "raid",
            "ufs",
            "sd_host",
            "usb_mass_storage",
            "other"
          ]
        },
        "driver": {
          "$ref": "#/$defs/optional_name"
        },
        "parent": {
          "$ref": "#/$defs/device_id"
        }
      }
    },
    "block_device": {
      "description": "A whole block device. Partitions and volumes belong to the storage service and are not listed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "id_basis",
        "sysfs_path",
        "name",
        "model",
        "vendor",
        "serial",
        "wwid",
        "transport",
        "removable",
        "rotational",
        "size_bytes",
        "driver",
        "parent"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/device_id"
        },
        "id_basis": {
          "$ref": "#/$defs/id_basis"
        },
        "sysfs_path": {
          "$ref": "#/$defs/sysfs_path"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "model": {
          "$ref": "#/$defs/optional_text"
        },
        "vendor": {
          "$ref": "#/$defs/optional_text"
        },
        "serial": {
          "$ref": "#/$defs/sensitive"
        },
        "wwid": {
          "$ref": "#/$defs/sensitive"
        },
        "transport": {
          "enum": [
            "nvme",
            "scsi",
            "usb",
            "mmc",
            "virtio",
            "other"
          ]
        },
        "removable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "rotational": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "driver": {
          "$ref": "#/$defs/optional_name"
        },
        "parent": {
          "oneOf": [
            {
              "$ref": "#/$defs/device_id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "input_device": {
      "description": "An input device.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "id_basis",
        "sysfs_path",
        "name",
        "bus",
        "vendor_id",
        "product_id",
        "version",
        "kinds",
        "phys",
        "uniq",
        "parent"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/device_id"
        },
        "id_basis": {
          "$ref": "#/$defs/id_basis"
        },
        "sysfs_path": {
          "$ref": "#/$defs/sysfs_path"
        },
        "name": {
          "$ref": "#/$defs/optional_text"
        },
        "bus": {
          "enum": [
            "pci",
            "usb",
            "bluetooth",
            "virtual",
            "i8042",
            "i2c",
            "host",
            "spi",
            "rmi",
            "other",
            "unknown"
          ]
        },
        "vendor_id": {
          "$ref": "#/$defs/hex4"
        },
        "product_id": {
          "$ref": "#/$defs/hex4"
        },
        "version": {
          "$ref": "#/$defs/hex4"
        },
        "kinds": {
          "type": "array",
          "items": {
            "enum": [
              "keyboard",
              "key",
              "mouse",
              "touchpad",
              "touchscreen",
              "tablet",
              "joystick",
              "switch",
              "pointing_stick",
              "accelerometer"
            ]
          }
        },
        "phys": {
          "$ref": "#/$defs/sensitive"
        },
        "uniq": {
          "$ref": "#/$defs/sensitive"
        },
        "parent": {
          "oneOf": [
            {
              "$ref": "#/$defs/device_id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "rfkill": {
      "description": "The state of a radio kill switch.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "soft_blocked",
        "hard_blocked"
      ],
      "properties": {
        "soft_blocked": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "hard_blocked": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "bluetooth_adapter": {
      "description": "A Bluetooth adapter.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "id_basis",
        "sysfs_path",
        "name",
        "driver",
        "address",
        "rfkill",
        "parent"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/device_id"
        },
        "id_basis": {
          "$ref": "#/$defs/id_basis"
        },
        "sysfs_path": {
          "$ref": "#/$defs/sysfs_path"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "driver": {
          "$ref": "#/$defs/optional_name"
        },
        "address": {
          "$ref": "#/$defs/sensitive"
        },
        "rfkill": {
          "oneOf": [
            {
              "$ref": "#/$defs/rfkill"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent": {
          "oneOf": [
            {
              "$ref": "#/$defs/device_id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "camera": {
      "description": "A V4L2 video device node.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "id_basis",
        "sysfs_path",
        "node",
        "name",
        "index",
        "capture",
        "driver",
        "parent"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/device_id"
        },
        "id_basis": {
          "$ref": "#/$defs/id_basis"
        },
        "sysfs_path": {
          "$ref": "#/$defs/sysfs_path"
        },
        "node": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/optional_text"
        },
        "index": {
          "type": [
            "integer",
            "null"
