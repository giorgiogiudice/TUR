<!--
  What Android may reach beyond the host (the owner's decision of
  15 November 2026; zone tur-android). From the Android container to every
  other zone: the internet is allowed; the local network is not, so that an
  Android application cannot reach printers, routers, NAS boxes or other
  computers of the person's network by default. "ANY" does not include the
  host itself (firewalld.policies(5)); the host is the zone's business.

  The private, link-local and shared address ranges are rejected first; the
  rest is accepted. Waydroid's own nftables table translates the addresses.
-->
<policy target="ACCEPT" priority="-100">
  <short>TUR Android out</short>
  <description>Android may reach the internet, not the local network.</description>
  <ingress-zone name="tur-android"/>
  <egress-zone name="ANY"/>
  <rule family="ipv4"><destination address="10.0.0.0/8"/><reject/></rule>
  <rule family="ipv4"><destination address="172.16.0.0/12"/><reject/></rule>
  <rule family="ipv4"><destination address="192.168.0.0/16"/><reject/></rule>
  <rule family="ipv4"><destination address="169.254.0.0/16"/><reject/></rule>
  <rule family="ipv4"><destination address="100.64.0.0/10"/><reject/></rule>
  <rule family="ipv6"><destination address="fc00::/7"/><reject/></rule>
  <rule family="ipv6"><destination address="fe80::/10"/><reject/></rule>
</policy>
