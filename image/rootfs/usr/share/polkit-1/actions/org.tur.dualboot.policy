<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  TUR and Windows on one computer (ADR-0029). Both write firmware boot
  variables only.
  - org.tur.dualboot: `pkexec tur-dualboot default tur|windows` changes which
    system starts by default: an administrator's password, kept for a few
    minutes.
  - org.tur.dualboot.restart-windows: "Restart into Windows" (BootNext, then
    a restart), through a helper that does nothing else. Like restarting, it
    is allowed to the person at the computer without a password; elsewhere
    an administrator's password.
-->
<policyconfig>
  <vendor>TUR</vendor>
  <action id="org.tur.dualboot">
    <description>Choose which system the computer starts</description>
    <message>Authentication is required to change which system this computer starts.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/tur-dualboot</annotate>
  </action>
  <action id="org.tur.dualboot.restart-windows">
    <description>Restart into Windows</description>
    <message>Authentication is required to restart this computer into Windows.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/tur/tur-restart-windows</annotate>
  </action>
</policyconfig>
