# SPDX-License-Identifier: LicenseRef-TUR-Noncommercial-1.0.0
#
# TUR operating-system image.
#
# The base is pinned by digest in image/base.lock and passed in by
# scripts/build-image.sh. Do not build this file directly with an unpinned base.
#
# The build context is the repository root. What is sent to the build is
# listed in image/Containerfile.containerignore.

ARG BASE_IMAGE
ARG BASE_DIGEST

# The toolchain that compiles TUR's own programs for the image: the official
# Rust image, pinned by digest (the tag is for people). Its version must be
# the one in rust-toolchain.toml; the build stage checks that. The programs
# are listed in image/programs.tsv. See image/README.md, "Programs built into
# the image".
ARG RUST_IMAGE=docker.io/library/rust
ARG RUST_TAG=1.99.1-slim-trixie
ARG RUST_DIGEST=sha256:f6c4a35d21dbb3c89d7a8d056c193e94fc09037f2b58dd858b09c39a47dd02d7

# ---- build stage: TUR programs ------------------------------------------------
FROM ${RUST_IMAGE}@${RUST_DIGEST} AS programs

# One target directory for every component, so that a crate two of them use
# in the same version is compiled once. The release profile is fixed here,
# for every program alike, so that two builds give the same bytes (the image
# workflow compares them): one code generation unit, nothing incremental, no
# debug information, symbols stripped. A component's own Cargo.toml need not
# repeat it.
ENV CARGO_TARGET_DIR=/build/target \
    CARGO_INCREMENTAL=0 \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 \
    CARGO_PROFILE_RELEASE_INCREMENTAL=false \
    CARGO_PROFILE_RELEASE_DEBUG=false \
    CARGO_PROFILE_RELEASE_STRIP=symbols \
    CARGO_TERM_COLOR=never

COPY rust-toolchain.toml /pin/rust-toolchain.toml
COPY image/programs.tsv /src/image/programs.tsv
COPY image/programs.sh /src/image/programs.sh
COPY LICENSE.md NOTICE /src/
COPY catalogue/ /src/catalogue/
COPY crates/ /src/crates/
COPY installer/tur-installer-core/ /src/installer/tur-installer-core/
COPY services/tur-boot-health/ /src/services/tur-boot-health/
COPY services/tur-catalogue/ /src/services/tur-catalogue/
COPY services/tur-device-manager/ /src/services/tur-device-manager/
COPY services/tur-diagnostics/ /src/services/tur-diagnostics/
COPY services/tur-pax/ /src/services/tur-pax/
COPY services/tur-pax-memory/ /src/services/tur-pax-memory/
COPY services/tur-pax-providers/ /src/services/tur-pax-providers/
COPY services/tur-runtime/ /src/services/tur-runtime/
COPY services/tur-storage/ /src/services/tur-storage/
COPY services/tur-update/ /src/services/tur-update/

# The only step with network access. It downloads the crates the committed
# lockfiles name, each checked against the SHA-256 its lockfile holds, and
# refuses a lockfile that would have to change. Nothing is compiled here.
RUN /bin/sh /src/image/programs.sh fetch

# No network: the programs are compiled from this repository, the crates
# fetched above and the pinned toolchain. --locked refuses a lockfile that
# does not match; --offline refuses to fetch anything.
RUN --network=none /bin/sh /src/image/programs.sh build

# ---- the image ------------------------------------------------------------------
FROM ${BASE_IMAGE}@${BASE_DIGEST}

ARG BASE_IMAGE
ARG BASE_DIGEST
ARG BASE_VERSION
ARG TUR_VERSION
ARG TUR_BUILD_ID
ARG TUR_SOURCE_REVISION

# Files owned by TUR. Everything here lives under /usr: the image is immutable
# and /etc and /var belong to the installed system.
COPY image/rootfs/ /

# What the build stage made (image/programs.sh): the TUR programs, the
# assistant tools of the components that ship them, the application
# catalogue, the list of what was installed (/usr/lib/tur/programs.tsv), the
# licence of TUR's own programs and the licence files of the third-party
# crates compiled into them.
COPY --from=programs /out/ /

# Boot-attempt counting (ADR-0014). bootupd concatenates every *.cfg in
# configs.d, sorted by name, into /boot/grub2/grub.cfg at installation. The
# fragment is BSD-3-Clause, not under the TUR licence: see
# image/third-party-licensed/grub/README.md.
COPY --chmod=0644 image/third-party-licensed/grub/08_tur_boot_count.cfg \
     /usr/lib/bootupd/grub2-static/configs.d/08_tur_boot_count.cfg
COPY --chmod=0644 image/third-party-licensed/grub/LICENSE \
     /usr/share/licenses/tur-grub-boot-count/LICENSE

# The build identity, and what the base called itself before TUR's
# os-release replaced Fedora's (below, image/branding/branding.sh).
RUN set -eu; \
    base() { ( . /usr/lib/os-release; eval "printf '%s' \"\${$1:-}\"" ); }; \
    test "$(base ID)" = fedora; \
    printf '%s\n' \
        "TUR_VERSION=${TUR_VERSION}" \
        "TUR_BUILD_ID=${TUR_BUILD_ID}" \
        "TUR_SOURCE_REVISION=${TUR_SOURCE_REVISION}" \
        "TUR_BASE_IMAGE=${BASE_IMAGE}" \
        "TUR_BASE_DIGEST=${BASE_DIGEST}" \
        "TUR_BASE_VERSION=${BASE_VERSION}" \
        "TUR_BASE_OS_ID=$(base ID)" \
        "TUR_BASE_OS_VERSION_ID=$(base VERSION_ID)" \
        "TUR_BASE_OS_VARIANT_ID=$(base VARIANT_ID)" \
        > /usr/lib/tur/release; \
    # The counting fragment sets variables that the menu entries use, so it
    # must be read before the fragment that builds the menu. Fail the build
    # if the base ever renames that fragment.
    test -f /usr/lib/bootupd/grub2-static/configs.d/10_blscfg.cfg; \
    # The programs were linked against the C library of the toolchain image,
    # which is older than this image's. Each runs once here, so that a
    # program that cannot start stops the build and not a boot.
    test "$(grep -c -v '^#' /usr/lib/tur/programs.tsv)" -ge 11; \
    chmod 0755 /usr/share/licenses/tur-grub-boot-count; \
    for path in $(grep -v '^#' /usr/lib/tur/programs.tsv | cut -f2); do \
        "${path}" --version || { echo "${path} does not run in this image" >&2; exit 1; }; \
    done; \
    # Boot health (ADR-0014; design section 10). The program is also on the
    # PATH, for `status` and `acknowledge`.
    ln -s ../libexec/tur/tur-boot-health /usr/bin/tur-boot-health; \
    # An automatic update agent would undo a rollback: bootc's own timer is
    # masked whether or not the base enables it. GRUB's boot-success timer
    # sets a variable that means nothing with bootupd's static configuration.
    ln -sf /dev/null /usr/lib/systemd/system/bootc-fetch-apply-updates.timer; \
    ln -sf /dev/null /usr/lib/systemd/user/grub-boot-success.timer

# Fedora's marks replaced (desktop-experience.md, section 12; image/README.md,
# "Fedora's marks"): Fedora's release and logo packages swapped for Fedora's
# mark-free generic ones (pinned in image/branding/packages.lock); TUR's
# os-release, logo, boot splash, wallpaper and desktop defaults; and the
# initramfs regenerated so that it carries them. The artwork comes from
# branding/, bound into this step rather than copied into a layer.
RUN --mount=type=bind,source=branding,target=/run/tur-art \
    --mount=type=bind,source=image/branding,target=/run/tur-branding \
    /bin/bash /run/tur-branding/branding.sh /run/tur-art /run/tur-branding \
        "${TUR_VERSION}" "${TUR_BUILD_ID}" && \
    bootc container lint

# ---- desktop theme and defaults (task D-04) -- one COPY, owned by desktop/ ------
# TUR's colour schemes, its two global themes, the system defaults for KDE
# (no splash, no KDE welcome window, TUR's theme on the login screen) and the
# panel of a new account. Data only, generated and checked in desktop/data
# (gen_theme.py; MANIFEST.tsv lists every file). After the branding step, so
# that these global themes replace the provisional one; and as its own small
# layer, so that a change here does not rebuild the step above.
COPY desktop/data/rootfs/ /
# ---- end of desktop theme and defaults ------------------------------------------

LABEL org.opencontainers.image.title="TUR" \
      org.opencontainers.image.description="TUR operating-system image (pre-alpha)" \
      org.opencontainers.image.source="https://github.com/giorgiogiudice/TUR" \
      org.opencontainers.image.version="${TUR_VERSION}" \
      org.opencontainers.image.revision="${TUR_SOURCE_REVISION}" \
      org.tur.build-id="${TUR_BUILD_ID}" \
      org.tur.base.image="${BASE_IMAGE}" \
      org.tur.base.digest="${BASE_DIGEST}"
