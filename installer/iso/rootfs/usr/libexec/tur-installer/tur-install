#!/usr/bin/bash
# SPDX-License-Identifier: LicenseRef-TUR-Noncommercial-1.0.0
#
# The text installer of TUR's installer medium (ADR-0018). Present only in
# the installer environment (installer/iso), where tur-installer.service runs
# it on the first console when the medium is started with the boot menu's
# "Install TUR (text mode)". The medium's default is the live session and its
# graphical installer; both use the same engine,
# /usr/lib/tur-installer/engine.sh, for everything that touches a disk.
#
# It does one of two things with the TUR image that is on the medium, with
# the installer the image carries:
#
#   - erase one whole disk and install TUR onto it:
#
#     bootc install to-disk --source-imgref oci:<medium>/payload:payload \
#         --target-imgref <name> --generic-image --wipe [--filesystem ext4] <disk>
#
#   - on a disk that holds Windows, install TUR into free space the person
#     made with Windows' own Shrink Volume, sharing Windows' EFI system
#     partition and adding Windows to TUR's boot menu (ADR-0029; engine.sh,
#     run_beside): one new partition, then
#
#     bootc install to-filesystem --source-imgref ... --target-imgref <name> <mounted partition>
#
# What it deliberately does not do, and says so on its first screen: shrink
# or move a Windows partition, encrypt, partition by hand, keep any data on a
# disk it erases, use a network.
#
# Safety rules it follows (AGENTS.md; specification 5.2 and 28.5):
#   - a disk is chosen by its stable identity (a /dev/disk/by-id link that
#     carries its serial number or WWN), never by a kernel name such as sda;
#   - the medium itself, a disk in use, a read-only disk, a disk without a
#     stable identity and a disk smaller than the tested minimum cannot be
#     chosen;
#   - nothing is written before the person has typed a phrase that names the
#     chosen disk ("ERASE" and the end of its serial number), on a screen that
#     shows the disk's model, capacity, serial number, stable path and what is
#     on it now. The phrase follows installer/tur-installer-core
#     (plan.rs, confirmation_phrase);
#   - immediately before writing, the disk behind the stable path is looked
#     at again and must be the same disk with the same content;
#   - every disk is described in plain words before anything is chosen:
#     Windows (an EFI system partition holding EFI/Microsoft/Boot), BitLocker,
#     NTFS, Linux filesystems. This is read-only: signatures are read with
#     lsblk and a few bytes with head, and an EFI system partition is mounted
#     read-only in a private mount namespace only to look for that directory.
#     A disk that holds Windows or BitLocker gets an explicit warning on the
#     confirmation screen;
#   - nothing is written to any disk but the chosen one. Erasing a disk writes
#     no firmware boot variable: `--generic-image` makes bootc skip bootupd's
#     firmware update (ADR-0018). Installing beside Windows adds a "TUR"
#     entry at the front of the boot order and leaves Windows' entry
#     (ADR-0029); its confirmation phrase starts with "BESIDE".
#
# Everything shown on the screen is also written, line by line, to the first
# serial port when the machine has one, with state lines that start with
# "TUR-INSTALLER: ". A person never needs them. tests/iso reads them, and
# drives this same program through the keyboard as a person would.
#
# Error codes: where a condition already has a code in
# installer/tur-installer-core/src/codes.rs, that code is used. Conditions
# only this medium has use TUR-INSTALL-MEDIUM-NNN (ADR-0018 lists them).
set -u

# Everything that decides about disks and writes to them is shared with the
# graphical installer: /usr/lib/tur-installer/engine.sh. It defines
# `transcript` and `mark` (the log and the serial port) and the facts of the
# medium.
# shellcheck source=installer/iso/rootfs/usr/lib/tur-installer/engine.sh
. /usr/lib/tur-installer/engine.sh

# ---- output -------------------------------------------------------------------

# say LINE: a line of the screen, and of the transcript.
say() {
    printf '%s\n' "${1-}"
    transcript "TUR-INSTALLER| ${1-}"
}

# screen NAME TITLE: start a new screen.
screen() {
    printf '\033[2J\033[H'
    transcript "TUR-INSTALLER| ----------------------------------------------------------------"
    say "TUR installer: $2"
    say "TUR ${tur_version:-?}, build ${tur_build_id:-?}"
    say ""
    current_screen="$1"
}

# ask PROMPT: print the prompt and read one line into `answer`. While it
# waits it repeats a state line every few seconds, so that whoever follows the
# serial port can tell which screen is waiting even if a line was lost.
ask() {
    local waited=0 status
    printf '%s' "$1"
    transcript "TUR-INSTALLER| $1"
    mark "prompt screen=${current_screen}"
    while :; do
        IFS= read -r -t 5 answer
        status=$?
        if [ "${status}" -eq 0 ]; then
            answer="${answer//$'\r'/}"
            # Trim spaces at both ends; keep the ones inside.
            answer="${answer#"${answer%%[![:space:]]*}"}"
            answer="${answer%"${answer##*[![:space:]]}"}"
            mark "input screen=${current_screen} text=\"${answer}\""
            return 0
        fi
        if [ "${status}" -gt 128 ]; then
            waited=$((waited + 5))
            mark "waiting screen=${current_screen} seconds=${waited}"
        else
            # The console was taken away (hung up, or read refused). Say so,
            # open it again and go on waiting.
            mark "console-lost screen=${current_screen} status=${status}"
            sleep 2
            exec 0< /dev/tty1 1> /dev/tty1 2> /dev/null
        fi
    done
}

# para TEXT: a paragraph of the screen, wrapped to the width of any console.
para() {
    local line
    while IFS= read -r line; do
        say "  ${line}"
    done < <(printf '%s\n' "$1" | fold -s -w 74)
}

current_screen=start
answer=""

# The progress of the check of the image on the medium, on one line.
verify_progress() {
    printf '\r  Checking the installation image on this medium: file %s of %s ' "$1" "$2"
}

# ---- screens ----------------------------------------------------------------------

power_off() {
    mark "power-off"
    say "Powering off."
    sync
    systemctl poweroff
    sleep infinity
}

command_line() {
    mark "shell=started"
    printf '\033[2J\033[H'
    echo 'Command line of the installer environment (root). Nothing here is needed to'
    echo 'install. Type "exit" to return to the installer.'
    echo
    stty isig 2> /dev/null
    # Interactive bash writes its prompt and what is typed to standard error,
    # which this unit sends to the journal: give it the console instead.
    PS1='tur-installer# ' /usr/bin/bash --norc --noprofile -i 2>&1
    stty -isig 2> /dev/null
    mark "shell=ended"
}

# common ANSWER: handle the answers every screen accepts. Returns 0 if handled.
common() {
    case "$1" in
        off) power_off ;;
        shell)
            command_line
            return 0
            ;;
    esac
    return 1
}

screen_welcome() {
    local item
    screen welcome "install TUR on this computer"
    say "This installs TUR on ONE WHOLE DISK of this computer and ERASES that disk,"
    say "or, on a disk that holds Windows, into free space beside Windows that you"
    say "made in Windows (Disk Management, Shrink Volume). Windows is then kept."
    say ""
    say "What this installer does not do:"
    say "  - shrink or move Windows, or any other partition"
    say "  - encrypt the disk"
    say "  - let you choose partitions, or keep any data on a disk it erases"
    say "It needs no network and uses none. The keyboard layout here is US English."
    say ""
    if [ "${payload_state}" = unknown ]; then
        verify_payload verify_progress
        printf '\r\033[K'
    fi
    run_checks
    say "Checks:"
    for item in "${check_lines[@]}"; do say "  ${item}"; done
    say ""
    if [ "${#blocking[@]}" -gt 0 ]; then
        say "TUR cannot be installed from here:"
        for item in "${blocking[@]}"; do
            say ""
            say "  ${item%%|*}"
            para "${item#*|}"
        done
        say ""
        mark "blocked count=${#blocking[@]}"
        while :; do
            ask 'Type "shell" for a command line or "off" to power off: '
            if common "${answer}"; then return 0; fi
        done
    fi
    say "Nothing is changed until you have chosen a disk and typed a confirmation."
    say ""
    ask 'Press Enter to choose a disk. ("shell": a command line; "off": power off) '
    if common "${answer}"; then return 0; fi
    state=disks
}

dumped=no
screen_disks() {
    local i shown=0
    screen disks "choose the disk to erase"
    scan_disks
    if [ "${dumped}" = no ]; then
        dump_inventory
        dumped=yes
    fi
    for i in "${!d_name[@]}"; do
        shown=$((shown + 1))
        if [ "${d_status[i]}" = ok ]; then
            say "  [${d_index[i]}]  ${d_model[i]:-unnamed disk}, $(human "${d_size[i]}"), ${d_tran[i]:-unknown connection}, serial $(serial_end "${i}")"
            say "       ${d_byid[i]}"
        else
            say "  [-]  ${d_model[i]:-unnamed disk}, $(human "${d_size[i]}"), ${d_tran[i]:-unknown connection}, serial $(serial_end "${i}")"
        fi
        say "       holds: ${d_holds[i]}"
        if [ "${d_status[i]}" = ok ] && [ "${d_windows[i]}" = yes ]; then
            if [ "${d_beside[i]}" = yes ]; then
                say "       beside Windows: possible, $(human "${d_bsize[i]}") of free space"
            else
                say "       beside Windows: not possible: ${d_bwhy[i]} (${d_bcode[i]})"
            fi
        fi
        if [ "${d_status[i]}" != ok ]; then
            say "       cannot be chosen: ${d_why[i]} (${d_code[i]})"
        fi
    done
    if [ "${shown}" -eq 0 ]; then
        say "  No disk was found."
    fi
    say ""
    if [ "${selectable}" -eq 0 ]; then
        say "TUR-INSTALL-MEDIUM-003"
        say "There is no disk TUR can be installed on. Nothing was changed."
        say "If the disk you expect is missing, the installer has no driver for its"
        say "controller, or the firmware hides it (look for a RAID or Intel RST setting"
        say "and set the controller to AHCI or NVMe)."
        say ""
        mark "no-target code=TUR-INSTALL-MEDIUM-003"
        ask 'Press Enter to look again. ("shell": a command line; "off": power off) '
        if common "${answer}"; then return 0; fi
        if [ -n "${answer}" ]; then
            mark "choice result=invalid"
            say "There is no disk to choose."
            sleep 2
        fi
        return 0
    fi
    ask "Type the number of a disk, then Enter. (Enter alone: look again; \"off\": power off) "
    if common "${answer}"; then return 0; fi
    if [ -z "${answer}" ]; then return 0; fi
    for i in "${!d_name[@]}"; do
        if [ "${d_index[i]}" = "${answer}" ]; then
            chosen="${i}"
            mode=erase
            mark "choice result=ok index=${answer} name=${d_name[i]}"
            if [ "${d_beside[i]}" = yes ]; then state=mode; else state=confirm; fi
            return 0
        fi
    done
    mark "choice result=invalid"
    say "\"${answer}\" is not one of the numbers in brackets."
    sleep 3
}

# How to install on a disk that holds Windows and has room beside it.
mode=erase
screen_mode() {
    local i="${chosen}"
    screen mode "keep Windows, or erase the disk"
    say "  Disk: ${d_model[i]:-unnamed disk}, $(human "${d_size[i]}"), serial $(serial_end "${i}")"
    say "  This disk holds Windows and has $(human "${d_bsize[i]}") of free space."
    say ""
    say "  [1]  Use the free space beside Windows. Windows and its files are kept."
    say "       TUR goes into the free space; TUR's start menu offers Windows too."
    say "  [2]  Erase the whole disk. Windows and everything on the disk is lost."
    say ""
    ask "Type 1 or 2, then Enter. (Enter alone goes back) "
    case "${answer}" in
        1)
            mode=beside
            mark "mode chosen=beside name=${d_name[i]}"
            state=default
            ;;
        2)
            mode=erase
            mark "mode chosen=erase name=${d_name[i]}"
            state=confirm
            ;;
        "")
            mark "mode chosen=back"
            state=disks
            ;;
        *)
            if common "${answer}"; then return 0; fi
            mark "mode chosen=invalid"
            say "\"${answer}\" is not 1 or 2."
            sleep 3
            ;;
    esac
}

# Which system starts when the computer is switched on (beside Windows).
default_system=tur
screen_default() {
    screen default "which system starts by default"
    say "  When you switch the computer on, which system should start?"
    say ""
    say "  [1]  TUR. TUR's start menu also offers Windows."
    say "  [2]  Windows. TUR is then started from the computer's boot menu."
    say ""
    say "  You can change this later in TUR: tur-dualboot default tur|windows."
    say ""
    ask "Type 1 or 2, then Enter. (Enter alone goes back) "
    case "${answer}" in
        1 | 2)
            if [ "${answer}" = 1 ]; then default_system=tur; else default_system=windows; fi
            mark "default chosen=${default_system}"
            state=confirm
            ;;
        "")
            mark "default chosen=back"
            state=mode
            ;;
        *)
            if common "${answer}"; then return 0; fi
            mark "default chosen=invalid"
            say "\"${answer}\" is not 1 or 2."
            sleep 3
            ;;
    esac
}

# The confirmation of an installation beside Windows (ADR-0029).
screen_confirm_beside() {
    local i="${chosen}" phrase line
    screen confirm "confirm installing beside Windows"
    phrase="$(beside_phrase_for "${i}")"
    confirmed_fingerprint="$(fingerprint "${d_name[i]}")"
    say "  Disk:       ${d_model[i]:-unnamed disk}"
    say "  Capacity:   $(human "${d_size[i]}") (${d_size[i]} bytes)"
    say "  Connection: ${d_tran[i]:-unknown}"
    say "  Serial:     ${d_serial[i]:-none reported}${d_wwn[i]:+   WWN: ${d_wwn[i]}}"
    say "  Path:       ${d_byid[i]}"
    say "  (A serial number identifies your hardware. Mind it if you share a photo.)"
    say ""
    say "  On this disk now, ALL OF WHICH IS KEPT:"
    while IFS= read -r line; do
        say "     ${line}"
    done < <(contents "${d_name[i]}")
    say ""
    say "  What will be written:"
    say "   - a new partition for TUR in the free space: $(human "${d_bsize[i]}"),"
    say "     from byte ${d_bstart[i]}${d_bbefore[i]:+, after ${d_bbefore[i]}}${d_bafter[i]:+, before ${d_bafter[i]}}"
    say "   - TUR's start-up files added to the EFI system partition ${d_besp[i]##*/}"
    say "     ($(human "${d_bneed[i]}") of its $(human "${d_bespfree[i]}") free); Windows' files there are kept"
    if [ "${default_system}" = tur ]; then
        say "   - the computer starts TUR by default (its boot order); Windows' entry stays"
    else
        say "   - the computer starts Windows by default; a \"TUR\" entry follows it"
    fi
    say "   - \"Windows\" in TUR's start menu"
    say "  No Windows partition is changed, moved or shrunk. Not encrypted."
    say ""
    say "  Back up what matters to you before you go on."
    if [ "${d_bitlocker[i]}" = yes ]; then
        say "  This disk holds data encrypted with BitLocker. Starting Windows from TUR's"
        say "  menu may make Windows ask for its BitLocker recovery key: have it ready."
        mark "confirm-warning kind=bitlocker-beside"
    fi
    say ""
    mark "confirm name=${d_name[i]} by_id=${d_byid[i]} phrase=\"${phrase}\" mode=beside free_start=${d_bstart[i]} free_size=${d_bsize[i]} default=${default_system}"
    say "To install TUR beside Windows on this disk, type exactly:  ${phrase}"
    ask "(Enter alone goes back and changes nothing) > "
    if [ -z "${answer}" ]; then
        mark "confirm result=back"
        state=disks
        return 0
    fi
    if [ "${answer}" != "${phrase}" ]; then
        mark "confirm result=mismatch code=TUR-INSTALL-CONFIRM-001"
        say ""
        say "TUR-INSTALL-CONFIRM-001"
        say "That is not the phrase. Nothing was changed. The phrase has capital"
        say "letters and one space, exactly as shown."
        sleep 4
        return 0
    fi
    mark "confirm result=accepted mode=beside"
    state=install
}

chosen=""
confirmed_fingerprint=""
screen_confirm() {
    local i="${chosen}" phrase line
    if [ "${mode}" = beside ]; then
        screen_confirm_beside
        return
    fi
    screen confirm "confirm erasing this disk"
    phrase="$(phrase_for "${i}")"
    confirmed_fingerprint="$(fingerprint "${d_name[i]}")"
    say "  Disk:       ${d_model[i]:-unnamed disk}"
    say "  Capacity:   $(human "${d_size[i]}") (${d_size[i]} bytes)"
    say "  Connection: ${d_tran[i]:-unknown}"
    say "  Serial:     ${d_serial[i]:-none reported}${d_wwn[i]:+   WWN: ${d_wwn[i]}}"
    say "  Path:       ${d_byid[i]}"
    say "  (A serial number identifies your hardware. Mind it if you share a photo.)"
    say ""
    if [ -z "$(contents "${d_name[i]}")" ]; then
        say "  On this disk now: no partitions. Anything on it will still be erased."
    else
        say "  On this disk now, ALL OF WHICH WILL BE DESTROYED:"
        while IFS= read -r line; do
            say "     ${line}"
        done < <(contents "${d_name[i]}")
    fi
    say ""
    say "  What will be written: a new GPT partition table with a 1 MiB BIOS boot"
    say "  partition, an EFI system partition, and one ext4 partition with TUR on"
    say "  the rest of the disk. Not encrypted. No other operating system and no"
    say "  data are kept."
    say ""
    if [ "${d_windows[i]}" = yes ] || [ "${d_bitlocker[i]}" = yes ]; then
        say "  !!! WARNING !!!"
        say "  This disk holds Windows. Erasing it removes Windows and everything on it."
        if [ "${d_bitlocker[i]}" = yes ]; then
            say "  It also holds a BitLocker-encrypted volume, which is lost with it."
        fi
        say "  To keep Windows, press Enter alone to go back, and choose another disk."
        say ""
        mark "confirm-warning kind=windows windows=${d_windows[i]} bitlocker=${d_bitlocker[i]}"
    fi
    mark "confirm name=${d_name[i]} by_id=${d_byid[i]} phrase=\"${phrase}\""
    say "To erase this disk and install TUR, type exactly:  ${phrase}"
    ask "(Enter alone goes back and changes nothing) > "
    if [ -z "${answer}" ]; then
        mark "confirm result=back"
        state=disks
        return 0
    fi
    if [ "${answer}" != "${phrase}" ]; then
        mark "confirm result=mismatch code=TUR-INSTALL-CONFIRM-001"
        say ""
        say "TUR-INSTALL-CONFIRM-001"
        say "That is not the phrase. Nothing was changed. The phrase has capital"
        say "letters and one space, exactly as shown."
        sleep 4
        return 0
    fi
    mark "confirm result=accepted"
    state=install
}

# fail CODE MESSAGE...: the last screen of a failed run.
fail() {
    local code="$1" line
    shift
    screen failed "the installation did not complete"
    say "${code}"
    for line in "$@"; do say "${line}"; done
    say ""
    if [ -s "${INSTALL_LOG}" ]; then
        say "The last lines of the installation log (${INSTALL_LOG}):"
        while IFS= read -r line; do
            say "  ${line:0:76}"
        done < <(tail -n 12 "${INSTALL_LOG}")
        say ""
    fi
    say "Photograph this screen if you report the problem. To try again, power off"
    say "and start from the medium again."
    mark "result=failed code=${code}"
    while :; do
        ask 'Type "shell" for a command line or "off" to power off: '
        common "${answer}"
    done
}

# Look at the chosen disk again, immediately before writing (engine.sh,
# revalidate): the same disk, behind the same stable path, with the same
# content.
revalidate_chosen() {
    local i="${chosen}"
    if ! revalidate "${d_byid[i]}" "${d_serial[i]}" "${d_wwn[i]}" "${d_size[i]}" "${confirmed_fingerprint}"; then
        fail "${engine_code}" "${engine_message}" "Nothing was changed."
    fi
}

# show_new_lines PID: the installation's output on the screen, as it
# arrives (engine.sh, run_install, calls it about every two seconds).
shown=0
install_started=0
last_mark=0
show_new_lines() {
    local total line elapsed
    total="$(wc -l < "${INSTALL_LOG}")"
    if [ "${total}" -gt "${shown}" ]; then
        while IFS= read -r line; do
            line="${line//$'\r'/}"
            [ -n "${line}" ] && say "  ${line:0:76}"
        done < <(sed -n "$((shown + 1)),${total}p" "${INSTALL_LOG}")
        shown="${total}"
    fi
    [ -n "$1" ] || return 0
    elapsed=$((SECONDS - install_started))
    if [ $((elapsed - last_mark)) -ge 20 ]; then
        last_mark="${elapsed}"
        mark "installing elapsed=${elapsed}"
        printf '\r  ... %s s \r' "${elapsed}"
    fi
}

screen_install_beside() {
    local i="${chosen}"
    revalidate_chosen
    if ! beside_revalidate "${d_bstart[i]}" "${d_bsize[i]}"; then
        fail "${engine_code}" "${engine_message}" "Nothing was changed."
    fi
    screen installing "installing TUR beside Windows"
    say "  Disk: ${d_model[i]:-unnamed disk}, $(human "${d_size[i]}")"
    say "        ${d_byid[i]}"
    say "  Into: $(human "${d_bsize[i]}") of free space; Windows is kept."
    say ""
    say "Do not power off and do not remove the medium. This takes several minutes."
    say ""
    shown=0
    last_mark=0
    install_started="${SECONDS}"
    if ! run_beside "${target_device}" "${d_bstart[i]}" "${d_bsize[i]}" show_new_lines "${default_system}"; then
        case "${beside_disk_state}" in
            untouched) fail "${beside_code}" "${beside_message}" "Nothing was changed." ;;
            *)
                fail "${beside_code}" "${beside_message}" \
                    "Windows' partitions were not written. The free space now holds an" \
                    "unfinished TUR partition (${beside_partition:-see the log}). Windows still starts" \
                    "from the computer's boot menu."
                ;;
        esac
    fi
    if ! check_installed "${target_device}"; then
        fail TUR-INSTALL-MEDIUM-002 \
            "The installer reported success, but the disk does not have the partitions" \
            "an installed TUR has. Do not rely on TUR on this disk; Windows was kept."
    fi
    record_root_features "${target_device}"
    keep_log "${target_device}" "$(session_id)"
    state=finished
}

screen_install() {
    local i="${chosen}"
    if [ "${mode}" = beside ]; then
        screen_install_beside
        return
    fi
    revalidate_chosen
    screen installing "installing TUR"
    say "  Disk: ${d_model[i]:-unnamed disk}, $(human "${d_size[i]}")"
    say "        ${d_byid[i]}"
    say ""
    say "Do not power off and do not remove the medium. This takes several minutes."
    say ""
    shown=0
    last_mark=0
    install_started="${SECONDS}"
    run_install "${target_device}" show_new_lines
    if [ "${install_status}" -ne 0 ]; then
        fail TUR-INSTALL-MEDIUM-002 \
            "The installation stopped with an error (status ${install_status}) after ${install_seconds} s." \
            "The chosen disk was erased and holds no complete system. It cannot start" \
            "this computer until an installation completes."
    fi
    if ! check_installed "${target_device}"; then
        fail TUR-INSTALL-MEDIUM-002 \
            "The installer reported success after ${install_seconds} s, but the disk does not have" \
            "the partitions an installed TUR has. Do not rely on this disk."
    fi
    record_root_features "${target_device}"
    keep_log "${target_device}" "$(session_id)"
    state=finished
}

install_seconds=0
screen_finished() {
    local i="${chosen}" line
    screen finished "TUR is installed"
    if [ "${mode}" = beside ]; then
        say "TUR ${tur_version:-?} (build ${tur_build_id:-?}) was installed beside Windows in ${install_seconds} s on:"
    else
        say "TUR ${tur_version:-?} (build ${tur_build_id:-?}) was installed in ${install_seconds} s on:"
    fi
    say "  ${d_model[i]:-unnamed disk}, $(human "${d_size[i]}")"
    say "  ${d_byid[i]}"
    say ""
    while IFS= read -r line; do
        say "     ${line}"
    done < <(contents "${target_device##*/}")
    say ""
    if [ -n "${kept_log_path}" ]; then
        say "The installer's log is kept on the installed system in ${kept_log_path}."
        say ""
    fi
    say "Next:"
    say "  1. Press Enter. The computer powers off."
    say "  2. Remove the installer medium."
    say "  3. Switch the computer on. The first start shows a setup screen that"
    say "     creates your user account."
    if [ "${mode}" = beside ]; then
        say "  To start Windows from TUR: \"tur-dualboot restart-windows\""
        say "  (no BitLocker prompt), or \"Windows\" in TUR's start menu (key w)."
        say "  Change which system starts by default: \"pkexec tur-dualboot default\"."
    fi
    say ""
    mark "result=success seconds=${install_seconds} device=${target_device} mode=${mode}"
    while :; do
        ask 'Press Enter to power off. ("shell": a command line) '
        if [ "${answer}" = shell ]; then
            command_line
            continue
        fi
        power_off
    done
}

# ---- main -------------------------------------------------------------------------

# No key may interrupt the installer, and systemd's and the kernel's own
# messages must not be written across its screens.
# Nor may it be stopped for reading or writing its own console (SIGTTIN,
# SIGTTOU): a read then fails instead, and ask() opens the console again.
trap '' INT QUIT TSTP HUP TTIN TTOU
stty -isig 2> /dev/null
kill -s RTMIN+21 1 2> /dev/null
dmesg --console-level 4 > /dev/null 2>&1

mark "start version=${tur_version:-unknown} build_id=${tur_build_id:-unknown} revision=${tur_revision:-unknown} serial_port=${serial_port} kernel=$(uname -r)"
mark "cmdline $(cat /proc/cmdline)"
mark "live-medium source=$(findmnt -n -o SOURCE,FSTYPE "${LIVE_MOUNT}" 2> /dev/null | tr -s ' ' | head -n 1) root=$(findmnt -n -o SOURCE,FSTYPE / | tr -s ' ' | head -n 1)"

state=welcome
while :; do
    case "${state}" in
        welcome) screen_welcome ;;
        disks) screen_disks ;;
        mode) screen_mode ;;
        default) screen_default ;;
        confirm) screen_confirm ;;
        install) screen_install ;;
        finished) screen_finished ;;
        *) state=welcome ;;
    esac
done
